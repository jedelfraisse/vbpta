<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap.css" />
    <link rel="stylesheet" href="@Assets["app.css"]?v=@CacheBustToken" />
    <link rel="stylesheet" href="@Assets["WebApp.styles.css"]?v=@CacheBustToken" />


    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="bootstrap.bundle.min.js"></script>
</body>

</html>

@code {
    // ModuleVersionId changes on every single compile, so this query string
    // forces browsers to fetch fresh CSS after every rebuild/republish instead
    // of silently reusing a cached copy served under the same unversioned URL.
    private static readonly string CacheBustToken =
        typeof(App).Assembly.ManifestModule.ModuleVersionId.ToString("N");
}
