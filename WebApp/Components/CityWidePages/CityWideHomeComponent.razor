@using SiteEngine.Entities
@using SiteEngine.Services
@using WebApp.Components.Boxes
@page "/citywide/overview"

@inject ISiteContentService SiteContent
@inject IBlockParser BlockParser

<div class="citywide-block-container">
    @foreach (var block in Blocks)
    {
        <div class="@GetCssClass(block.Size)" style="@BuildStyle(block.Parameters)">

            @if (!string.IsNullOrWhiteSpace(block.Title))
            {
                <div class="block-title">@block.Title</div>
            }

            <div class="block-body">
                @if (block.Type == BlockType.Markdown)
                {
                    @((MarkupString)(block.Html ?? ""))
                }
                else if (block.Type == BlockType.Helper)
                {
                    <DynamicComponent Type="@HelperComponentMap[block.HelperName!]" Parameters="@(BuildHelperParams(block))" />
                }
            </div>
        </div>
    }
</div>

@code {
    private List<BlockResult> Blocks = new();

    private Dictionary<string, Type> HelperComponentMap = new()
    {
        { "events", typeof(EventsSmallBox) },
        { "boardlist", typeof(BoardListFullBox) }
    };

    protected override async Task OnInitializedAsync()
    {
        var page = await SiteContent.GetPageAsync("citywide-home");
        Blocks = BlockParser.Parse(page.Text);
    }

    private string GetCssClass(BlockSize size)
    {
        return size switch
        {
            BlockSize.Small => "city-card-half",
            BlockSize.Full => "city-card",
            _ => ""
        };
    }

    private string BuildStyle(Dictionary<string, string> parameters)
    {
        if (parameters == null || parameters.Count == 0)
            return "";

        return string.Join("; ", parameters.Select(p => $"--{p.Key}: {p.Value}"));
    }

    private Dictionary<string, object> BuildHelperParams(BlockResult block)
    {
        return block.Parameters.ToDictionary(
            p => p.Key,
            p => (object)p.Value
        );
    }
}
