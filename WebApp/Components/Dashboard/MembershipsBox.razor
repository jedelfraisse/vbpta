@using SiteEngine.Enums
@using WebApp.Services

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="card-title mb-0">Units &amp; Divisions</h5>

            @if (_availableRoles.Count > 1)
            {
                <div class="d-flex align-items-center gap-2">
                    <label for="roleFilter" class="form-label mb-0 small text-muted">Show only where I am a</label>
                    <select id="roleFilter" class="form-select form-select-sm" style="width:auto;" @bind="_roleFilter">
                        <option value="">any role</option>
                        @foreach (var role in _availableRoles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (Memberships.Count == 0)
        {
            <p class="text-muted mb-0">You're not a member of any Division or Local Unit yet.</p>
        }
        else if (_filteredMemberships.Count == 0)
        {
            <p class="text-muted mb-0">No Divisions or Local Units match that role.</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-0">
                @foreach (var m in _filteredMemberships)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2 px-0">
                        <div>
                            <div class="fw-semibold">@m.SiteName</div>
                            <span class="badge text-bg-secondary">@m.SiteType</span>
                            <span class="text-muted small">@m.SchoolYear</span>
                            @foreach (var label in m.RoleLabels)
                            {
                                <span class="badge text-bg-info">@label</span>
                            }
                        </div>
                        @{ var url = SiteUrl(m.SiteId, m.Hostname, m.Domain); }
                        @if (url is not null)
                        {
                            <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="@url" target="_blank" rel="noopener noreferrer">Visit site &rarr;</a>
                        }
                    </li>
                }
            </ul>
        }

        @if (VisitedSites.Count > 0)
        {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="showVisited" @bind="_showVisited" />
                <label class="form-check-label small text-muted" for="showVisited">
                    Also show sites you've logged into
                </label>
            </div>

            @if (_showVisited)
            {
                <ul class="list-group list-group-flush mt-2">
                    @foreach (var v in VisitedSites)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2 px-0">
                            <div>
                                <div class="fw-semibold">@v.SiteName</div>
                                <span class="badge text-bg-secondary">@v.SiteType</span>
                                <span class="text-muted small">Last visited @v.LastLoginUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                            @{ var url = SiteUrl(v.SiteId, v.Hostname, v.Domain); }
                            @if (url is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="@url" target="_blank" rel="noopener noreferrer">Visit site &rarr;</a>
                            }
                        </li>
                    }
                </ul>
            }
        }

        @if (AdminSites.Count > 0)
        {
            <a class="btn btn-sm btn-outline-primary mt-3" href="/portaladmin">Manage Sites &amp; Settings &rarr;</a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<MembershipSummary> Memberships { get; set; } = new();
    [Parameter] public List<VisitedSiteSummary> VisitedSites { get; set; } = new();

    // Used to build each row's "Visit site" link (SiteUrlHelper needs the
    // portal's domain to turn a bare Hostname into a full subdomain URL).
    [Parameter] public string? PortalDomain { get; set; }

    // The site the Dashboard is currently being viewed from — its own row
    // (if any) gets no "Visit site" link, since the viewer is already there.
    [Parameter] public Guid? CurrentSiteId { get; set; }

    private string _roleFilter = "";
    private bool _showVisited;

    // Only roles the user actually holds populate the filter — not every
    // possible SiteRole value — and custom role names are included too.
    private List<string> _availableRoles =>
        Memberships
            .SelectMany(m => m.RoleLabels)
            .Distinct()
            .OrderByDescending(label => Enum.TryParse<SiteRole>(label, out var role) ? (int)role : -1)
            .ThenBy(label => label)
            .ToList();

    private List<MembershipSummary> _filteredMemberships =>
        string.IsNullOrEmpty(_roleFilter)
            ? Memberships
            : Memberships.Where(m => m.RoleLabels.Contains(_roleFilter)).ToList();

    // Drives the "Manage Sites & Settings" link (formerly its own Site Admin
    // card) — computed from the full list, not the role filter, so it
    // doesn't disappear just because the viewer filtered to a lower role.
    private List<MembershipSummary> AdminSites => Memberships.Where(m => m.Role >= SiteRole.SiteAdmin).ToList();

    private string? SiteUrl(Guid siteId, string hostname, string domain)
    {
        if (siteId == CurrentSiteId)
            return null;

        var url = SiteUrlHelper.BuildPublicUrl(hostname, domain, PortalDomain);
        return string.IsNullOrEmpty(url) ? null : url;
    }
}
