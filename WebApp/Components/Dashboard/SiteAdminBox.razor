@using SiteEngine.Enums
@using WebApp.Services

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Site Admin</h5>
        <p class="text-muted">Sites where you hold the Site Admin role.</p>

        @if (AdminSites.Count == 0)
        {
            <p class="text-muted mb-0">You don't administer any sites yet.</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var m in AdminSites)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <div class="fw-semibold">@m.SiteName</div>
                            <span class="badge text-bg-secondary">@m.SiteType</span>
                        </div>
                    </li>
                }
            </ul>
        }

        <a class="btn btn-sm btn-outline-primary" href="/portaladmin">Manage Sites &amp; Settings &rarr;</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<MembershipSummary> Memberships { get; set; } = new();

    private List<MembershipSummary> AdminSites => Memberships.Where(m => m.Role >= SiteRole.SiteAdmin).ToList();
}
