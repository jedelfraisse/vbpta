@page "/globaladmin/sites/create"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Create Site</PageTitle>

<h1>Create Site</h1>

@if (!_initialized)
{
	<p>Loading...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin%2Fsites%2Fcreate">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else
{
	<p><a href="/globaladmin/sites">Back to Sites</a></p>

	<EditForm Model="_request" OnValidSubmit="CreateSiteAsync">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div>
			<label for="ptaId">PTA ID (8 digits)</label><br />
			<InputText id="ptaId" @bind-Value="_request.PtaId" />
		</div>
		<div>
			<label for="hostname">Hostname</label><br />
			<InputText id="hostname" @bind-Value="_request.Hostname" />
		</div>
		<div>
			<label for="domain">Custom Domain</label><br />
			<InputText id="domain" @bind-Value="_request.Domain" />
		</div>
		<div>
			<label for="isCityWide">City-Wide Site</label><br />
			<InputCheckbox id="isCityWide" @bind-Value="_request.IsCityWide" />
		</div>
		<div>
			<label for="siteName">Site Name</label><br />
			<InputText id="siteName" @bind-Value="_request.SiteName" />
		</div>
		<div>
			<label for="logoUrl">Logo URL</label><br />
			<InputText id="logoUrl" @bind-Value="_request.LogoUrl" />
		</div>
		<div>
			<label for="bannerUrl">Banner URL</label><br />
			<InputText id="bannerUrl" @bind-Value="_request.BannerUrl" />
		</div>
		<div>
			<label for="primaryColor">Primary Color</label><br />
			<InputText id="primaryColor" @bind-Value="_request.PrimaryColor" />
		</div>
		<div>
			<label for="accentColor">Accent Color</label><br />
			<InputText id="accentColor" @bind-Value="_request.AccentColor" />
		</div>
		<div>
			<label for="welcomeText">Welcome Text</label><br />
			<InputTextArea id="welcomeText" @bind-Value="_request.WelcomeText" />
		</div>

		<button type="submit">Create Site</button>
	</EditForm>

	@if (!string.IsNullOrWhiteSpace(_statusMessage))
	{
		<p>@_statusMessage</p>
	}
}

@code {
	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private string? _userId;
	private string _statusMessage = string.Empty;

	private readonly AdminCreateSiteRequest _request = new()
	{
		PrimaryColor = "#003366",
		AccentColor = "#FFCC00",
		WelcomeText = "Welcome to our community!"
	};

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_userId, SiteRole.Admin);
		}

		_initialized = true;
	}

	private async Task CreateSiteAsync()
	{
		try
		{
			var siteId = await AdminDashboardService.CreateSiteAsync(_userId, _request);
			NavigationManager.NavigateTo($"/globaladmin/sites/{siteId}");
		}
		catch (InvalidOperationException ex)
		{
			_statusMessage = ex.Message;
		}
	}
}
