@page "/admin/users/create"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Create User</PageTitle>

<h1>Create User</h1>

@if (!_initialized)
{
	<p>Loading...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin%2Fusers%2Fcreate">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else
{
	<p><a href="/admin/users">Back to Users</a></p>

	<EditForm Model="_request" OnValidSubmit="CreateUserAsync">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div>
			<label for="email">Email</label><br />
			<InputText id="email" @bind-Value="_request.Email" />
		</div>
		<div>
			<label>
				<InputCheckbox @bind-Value="_request.IsGlobalAdmin" />
				Make this user a global admin
			</label>
		</div>

		<button type="submit">Create User</button>
	</EditForm>

	@if (!string.IsNullOrWhiteSpace(_statusMessage))
	{
		<p>@_statusMessage</p>
	}
}

@code {
	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private string? _userId;
	private string _statusMessage = string.Empty;
	private readonly AdminCreateUserRequest _request = new();

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_userId, SiteRole.Admin);
		}

		_initialized = true;
	}

	private async Task CreateUserAsync()
	{
		try
		{
			var createdUserId = await AdminDashboardService.CreateUserAsync(_userId, _request);
			NavigationManager.NavigateTo($"/admin/users/{Uri.EscapeDataString(createdUserId)}/edit");
		}
		catch (InvalidOperationException ex)
		{
			_statusMessage = ex.Message;
		}
	}
}
