@page "/globaladmin/users/{UserId}/edit"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Edit User</PageTitle>

<h1>Edit User</h1>

@if (!_initialized)
{
	<p>Loading...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin%2Fusers">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else if (!_userLoaded)
{
	<p>User not found.</p>
}
else
{
	<p><a href="/globaladmin/users">Back to Users</a></p>

	<EditForm Model="_request" OnValidSubmit="UpdateUserAsync">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div>
			<label for="email">Email</label><br />
			<InputText id="email" @bind-Value="_request.Email" />
		</div>
		<div>
			<label>
				<InputCheckbox @bind-Value="_request.IsGlobalAdmin" />
				Global admin
			</label>
		</div>

		<button type="submit">Save User</button>
	</EditForm>

	@if (_detail is not null)
	{
		<h2>Site Role Assignments</h2>
		@if (_detail.SiteRoles.Count == 0)
		{
			<p>No site roles assigned.</p>
		}
		else
		{
			<table>
				<thead>
					<tr>
						<th>Site</th>
						<th>Hostname</th>
						<th>Role</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var role in _detail.SiteRoles)
					{
						<tr>
							<td>@role.SiteName</td>
							<td>@role.Hostname</td>
							<td>@role.Role</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}

	@if (!string.IsNullOrWhiteSpace(_statusMessage))
	{
		<p>@_statusMessage</p>
	}
}

@code {
	[Parameter]
	public string UserId { get; set; } = string.Empty;

	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private bool _userLoaded;
	private string? _currentUserId;
	private string _statusMessage = string.Empty;
	private AdminUserDetail? _detail;
	private readonly AdminUpdateUserRequest _request = new();

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_currentUserId, SiteRole.Admin);
			if (_isAdmin)
			{
				_detail = await AdminDashboardService.GetUserDetailAsync(_currentUserId, Uri.UnescapeDataString(UserId));
				if (_detail is not null)
				{
					_userLoaded = true;
					_request.Email = _detail.Email;
					_request.IsGlobalAdmin = _detail.IsGlobalAdmin;
				}
			}
		}

		_initialized = true;
	}

	private async Task UpdateUserAsync()
	{
		try
		{
			var targetUserId = Uri.UnescapeDataString(UserId);
			var updated = await AdminDashboardService.UpdateUserAsync(_currentUserId, targetUserId, _request);
			if (!updated)
			{
				_statusMessage = "User not found.";
				return;
			}

			_statusMessage = "User updated.";
			_detail = await AdminDashboardService.GetUserDetailAsync(_currentUserId, targetUserId);
		}
		catch (InvalidOperationException ex)
		{
			_statusMessage = ex.Message;
		}
	}
}
