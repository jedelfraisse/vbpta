@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAdminDashboardService AdminDashboardService
@using SiteEngine.Data
@using SiteEngine.Entities

<div class="AdminHome">
    @if (_overview is null)
    {
        <p>Loading dashboard...</p>
    }
    else
    {
        <div class="dashboard-grid">
            <div class="dashboard-card"><h3>Sites</h3><p>@_overview.TotalSites</p></div>
            <div class="dashboard-card"><h3>Total Users</h3><p>@_overview.TotalUsers</p></div>
            <div class="dashboard-card"><h3>Assigned Users</h3><p>@_overview.AssignedUsers</p></div>
            <div class="dashboard-card"><h3>Global Admins</h3><p>@_overview.GlobalAdmins</p></div>
        </div>

        <p>Use the management pages above for site and user administration.</p>
    }
</div>

@code {
    private string? _userId;
    private AdminDashboardOverview? _overview;

    protected override async Task OnInitializedAsync()
    {
        var host = new Uri(NavigationManager.Uri).Host;
        await SiteContext.InitializeAsync(host);
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _overview = await AdminDashboardService.GetOverviewAsync(_userId);
    }
}
