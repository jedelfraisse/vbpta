@page "/globaladmin/settings"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IPlatformConfigurationService PlatformConfigurationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Platform Settings</PageTitle>

<h1>Platform Settings</h1>

@if (!_initialized)
{
	<p>Loading...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin%2Fsettings">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else
{
	<p><a href="/admin">Back to Dashboard</a></p>

	<EditForm Model="_request" OnValidSubmit="SaveAsync">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div>
			<label for="rootDomain">Root Domain</label><br />
			<InputText id="rootDomain" @bind-Value="_request.RootDomain" />
		</div>
		<div>
			<label for="platformDomain">Platform Domain</label><br />
			<InputText id="platformDomain" @bind-Value="_request.PlatformDomain" />
		</div>
		<div>
			<label for="cityWidePtaId">City-Wide PTA ID (8 digits)</label><br />
			<InputText id="cityWidePtaId" @bind-Value="_request.CityWidePtaId" />
		</div>
		<div>
			<label for="cityWideSiteName">City-Wide PTA Name</label><br />
			<InputText id="cityWideSiteName" @bind-Value="_request.CityWideSiteName" />
		</div>
		<div>
			<label for="smtpHost">SMTP Host</label><br />
			<InputText id="smtpHost" @bind-Value="_request.SmtpHost" />
		</div>
		<div>
			<label for="smtpPort">SMTP Port</label><br />
			<InputNumber id="smtpPort" @bind-Value="_request.SmtpPort" />
		</div>
		<div>
			<label for="smtpFromAddress">Default From Email</label><br />
			<InputText id="smtpFromAddress" @bind-Value="_request.SmtpFromAddress" />
		</div>
		<div>
			<label for="smtpUsername">SMTP Username</label><br />
			<InputText id="smtpUsername" @bind-Value="_request.SmtpUsername" />
		</div>
		<div>
			<label for="smtpPassword">SMTP Password</label><br />
			<InputText id="smtpPassword" @bind-Value="_request.SmtpPassword" />
		</div>
		<div>
			<label for="useSsl">Use SSL</label><br />
			<InputCheckbox id="useSsl" @bind-Value="_request.UseSsl" />
		</div>

		<button type="submit">Save Settings</button>
	</EditForm>

	@if (!string.IsNullOrWhiteSpace(_statusMessage))
	{
		<p>@_statusMessage</p>
	}
}

@code {
	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private string? _userId;
	private string _statusMessage = string.Empty;
	private readonly PlatformSettingsUpdateRequest _request = new();

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_userId, SiteRole.Admin);
			if (_isAdmin)
			{
				var settings = await PlatformConfigurationService.GetPlatformSettingsAsync(_userId);
				_request.RootDomain = settings.RootDomain;
				_request.PlatformDomain = settings.PlatformDomain;
				_request.SmtpHost = settings.SmtpHost;
				_request.SmtpPort = settings.SmtpPort;
				_request.SmtpFromAddress = settings.SmtpFromAddress;
				_request.SmtpUsername = settings.SmtpUsername;
				_request.SmtpPassword = settings.SmtpPassword;
				_request.UseSsl = settings.UseSsl;
				_request.CityWidePtaId = settings.CityWidePtaId;
				_request.CityWideSiteName = settings.CityWideSiteName;
			}
		}

		_initialized = true;
	}

	private async Task SaveAsync()
	{
		try
		{
			await PlatformConfigurationService.UpdatePlatformSettingsAsync(_userId, _request);
			_statusMessage = "Settings saved.";
		}
		catch (InvalidOperationException ex)
		{
			_statusMessage = ex.Message;
		}
	}
}
