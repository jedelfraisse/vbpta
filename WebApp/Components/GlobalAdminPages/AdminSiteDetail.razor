@page "/globaladmin/sites/{SiteId:guid}"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Site Details</PageTitle>

<h1>Site Details</h1>

@if (!_initialized)
{
	<p>Loading site details...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
	<p>@_errorMessage</p>
}
else if (_detail is null)
{
	<p>Site not found.</p>
}
else
{
	<p><a href="/globaladmin/sites">Back to Sites</a></p>
	<p><a class="btn btn-secondary" href="@($"/globaladmin/sites/{SiteId}/edit")">Edit Site Metadata</a></p>
	<p><a class="btn btn-primary" href="@BuildSiteAdminUrl(_detail)">Edit Site Admin</a></p>

	<table>
		<tbody>
			<tr><th>Site Name</th><td>@_detail.SiteName</td></tr>
			<tr><th>PTA ID</th><td>@_detail.PtaId</td></tr>
			<tr><th>Hostname</th><td>@_detail.Hostname</td></tr>
			<tr><th>Custom Domain</th><td>@_detail.Domain</td></tr>
			<tr><th>Portal Type</th><td>@(_detail.IsAdminPortal ? "Admin" : "Site")</td></tr>
			<tr><th>City-Wide</th><td>@(_detail.IsCityWide ? "Yes" : "No")</td></tr>
			<tr><th>Logo URL</th><td>@_detail.LogoUrl</td></tr>
			<tr><th>Banner URL</th><td>@_detail.BannerUrl</td></tr>
			<tr><th>Primary Color</th><td>@_detail.PrimaryColor</td></tr>
			<tr><th>Accent Color</th><td>@_detail.AccentColor</td></tr>
			<tr><th>Welcome Text</th><td>@_detail.WelcomeText</td></tr>
			<tr><th>Announcements</th><td>@_detail.AnnouncementCount</td></tr>
			<tr><th>Events</th><td>@_detail.EventCount</td></tr>
			<tr><th>Assigned Users</th><td>@_detail.AssignedUsers</td></tr>
			<tr><th>Admins</th><td>@_detail.AdminCount</td></tr>
			<tr><th>Board Members</th><td>@_detail.BoardMemberCount</td></tr>
			<tr><th>Volunteers</th><td>@_detail.VolunteerCount</td></tr>
		</tbody>
	</table>
}

@code {
	[Parameter]
	public Guid SiteId { get; set; }

	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private string? _userId;
	private string _errorMessage = string.Empty;
	private SiteEngine.Services.AdminSiteDetail? _detail;

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_userId, SiteRole.Admin);
			if (_isAdmin)
			{
				try
				{
					_detail = await AdminDashboardService.GetSiteDetailAsync(_userId, SiteId);
				}
				catch (InvalidOperationException ex)
				{
					_errorMessage = ex.Message;
				}
			}
		}

		_initialized = true;
	}

	private string BuildSiteAdminUrl(SiteEngine.Services.AdminSiteDetail site)
	{
		var currentUri = new Uri(NavigationManager.Uri);
		var baseHost = currentUri.Host.Replace("admin.", string.Empty, StringComparison.OrdinalIgnoreCase);
		var targetHost = site.Domain;
		if (string.IsNullOrWhiteSpace(targetHost))
		{
			if (site.IsCityWide || string.IsNullOrWhiteSpace(site.Hostname))
			{
				targetHost = baseHost;
			}
			else
			{
				targetHost = site.Hostname.Contains('.', StringComparison.Ordinal)
					? site.Hostname
					: $"{site.Hostname}.{baseHost}";
			}
		}

		var builder = new UriBuilder(currentUri.Scheme, targetHost)
		{
			Path = "/admin"
		};

		if (!currentUri.IsDefaultPort)
		{
			builder.Port = currentUri.Port;
		}

		return builder.Uri.ToString();
	}
}
