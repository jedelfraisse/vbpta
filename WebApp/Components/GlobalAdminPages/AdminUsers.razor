@page "/globaladmin/users"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using SiteEngine.Entities

<PageTitle>Manage Users</PageTitle>

<h1>Manage Users</h1>

@if (!_initialized)
{
	<p>Loading...</p>
}
else if (!SiteContext.IsAdminContext)
{
	<p>Admin access is only available from an admin hostname.</p>
}
else if (!_isAuthenticated)
{
	<p>You must <a href="/login?returnUrl=%2Fadmin%2Fusers">sign in</a> to use this page.</p>
}
else if (!_isAdmin)
{
	<NoAccess />
}
else
{
	<p><a href="/">Back to Dashboard</a></p>
	<p><a class="btn btn-primary" href="/globaladmin/users/create">Create User</a></p>

	@if (_users.Count == 0)
	{
		<p>No users found.</p>
	}
	else
	{
		<table>
			<thead>
				<tr>
					<th>Email</th>
					<th>Global Admin</th>
					<th>Assigned Sites</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var user in _users)
				{
					<tr>
						<td>@user.Email</td>
						<td>@(user.IsGlobalAdmin ? "Yes" : "No")</td>
						<td>@user.AssignedSiteCount</td>
						<td><a href="@($"/globaladmin/users/{Uri.EscapeDataString(user.UserId)}/edit")">Edit</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}

@code {
	private bool _initialized;
	private bool _isAuthenticated;
	private bool _isAdmin;
	private string? _userId;
	private IReadOnlyList<AdminUserSummary> _users = Array.Empty<AdminUserSummary>();

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		if (_isAuthenticated && SiteContext.IsAdminContext)
		{
			_isAdmin = await SiteContext.UserHasRoleAtCurrentSiteAsync(_userId, SiteRole.Admin);
			if (_isAdmin)
			{
				_users = await AdminDashboardService.GetUserSummariesAsync(_userId);
			}
		}

		_initialized = true;
	}
}
