@inherits SiteLayoutBase
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@inject IPlatformConfigurationService PlatformConfigurationService

@using WebApp.Components.SharedPages;

@code {
	private bool _isSetupMode;

	protected override async Task OnParametersSetAsync()
	{
		_isSetupMode = Http.HttpContext?.Items.ContainsKey("SetupMode") == true
			|| await PlatformConfigurationService.IsInitialSetupRequiredAsync();

		if (_isSetupMode)
		{
			return;
		}

		await RefreshUserStateAsync();
	}
}

@if (_isSetupMode)
{
	<InitialSetup />
}
else
{
	<style>
				:root {
					--primary-color: @SiteContext.SiteConfig.PrimaryColor;
					--accent-color: @SiteContext.SiteConfig.AccentColor;
				}
	</style>
	<div class="layout-shell admin-shell">
		<header class="page-header" role="banner">
			<div class="brand-block">
				<img class="site-logo" src="@SiteContext.SiteConfig.LogoUrl" alt="@SiteContext.SiteConfig.SiteName logo" />
				<div>
					<div class="site-kicker">Admin Portal</div>
					<h1>@SiteContext.SiteConfig.SiteName</h1>
				</div>

				<nav class="primary-nav" aria-label="Primary">
					<a href="/">Dashboard</a>
					@if (IsAuthenticated)
					{
						<a href="/globaladmin/users">Users</a>
						<a href="/globaladmin/settings">Settings</a>
						<a href="/globaladmin/sites">Unit Sites</a>
						<a href="/logout">Logout</a>
					}
					else
					{
						<a href="/login">Login</a>
					}
				</nav>
			</div>

		</header>
		<main class="layout-body">
			@Body
		</main>
	</div>
}

<style>
	.setup-center-box {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: min(90%, 420px);
		padding: 2rem;
		background: white;
		border-radius: 12px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.15);
		text-align: center;
		font-family: system-ui, sans-serif;
	}

		.setup-center-box h2 {
			margin-bottom: 1rem;
			font-size: 1.4rem;
			font-weight: 600;
		}

		.setup-center-box a {
			color: var(--primary-color, #3366ff);
			font-weight: 600;
			text-decoration: none;
		}

			.setup-center-box a:hover {
				text-decoration: underline;
			}
</style>