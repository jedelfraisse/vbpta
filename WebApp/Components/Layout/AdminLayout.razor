@inherits SiteLayoutBase

@code {
    protected override async Task OnParametersSetAsync()
    {
        await RefreshUserStateAsync();
    }
}

<style>
    :root {
        --primary-color: @SiteContext.SiteConfig.PrimaryColor;
        --accent-color: @SiteContext.SiteConfig.AccentColor;
    }
</style>

<div class="layout-shell admin-shell">
    <header class="page-header" role="banner">
        <div class="brand-block">
            <img class="site-logo" src="@SiteContext.SiteConfig.LogoUrl" alt="@SiteContext.SiteConfig.SiteName logo" />
            <div>
                <div class="site-kicker">Admin Portal</div>
                <h1>@SiteContext.SiteConfig.SiteName</h1>
            </div>
        </div>
        <nav>
            <a href="/">Dashboard</a>
            <span> | </span><a href="/globaladmin/sites">Sites</a>
            <span> | </span><a href="/globaladmin/users">Users</a>
            <span> | </span><a href="/globaladmin/settings">Settings</a>
            <span> | </span><a href="/">Admin View</a>
            <AuthorizeView>
                <Authorized>
                    <span> | </span><a href="/logout">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <span> | </span><a href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>


    
    <nav class="primary-nav" aria-label="Primary">
        <a href="/globaladmin/sites">Dashboard</a>
        <a href="#">About</a>
        <a href="#">Our Local Units</a>
        <a href="#">Programs</a>
        <a href="#">Get Involved</a>
        <a href="#">Events</a>
        <a href="#">Sponsors</a>
        <a href="/announcements">News/Announcements</a>
        <a href="#">Awards</a>
        @if (ShowAdminLink)
        {
            <a href="/admin">Admin</a>
        }
        <AuthorizeView>
            <Authorized>
                <a href="/logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>


    @if (ShowBootstrapReminder)
    {
        <div class="alert alert-warning" role="alert">
            You are signed in with bootstrap email <strong>@PasswordlessSignInService.BootstrapAdminEmail</strong>.
            Change it now before any other users can sign in:
            <a href="/bootstrap/change-email">Change bootstrap email</a>.
        </div>
    }

    <main class="layout-body">
        @Body
    </main>
</div>
