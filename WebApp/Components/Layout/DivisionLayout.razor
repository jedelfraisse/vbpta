@using WebApp.Services
@inherits SiteLayoutBase
@inject SiteContext SiteContext

@code {
    protected override async Task OnParametersSetAsync()
    {
        // Resolve the current Division site the same way Home.razor does, so
        // the role check below is scoped to it rather than defaulting to
        // Viewer (see SiteLayoutBase.RefreshUserStateAsync).
        await SiteContext.InitializeAsync(new Uri(NavigationManager.Uri).Host);
        await RefreshUserStateAsync(SiteContext.CurrentSite?.Id);
    }
}
<link href="CityWideLayout.css" rel="stylesheet" />

<div class="city-shell">
    <div class="top-strip">
        Division Layout
    </div>

    <header class="masthead" role="banner">
        <div class="masthead-logos">
            <img class="site-logo" src="SiteConfig.LogoUrl" alt="SiteConfig.SiteName logo" />
            <div class="masthead-title">
                <h1>SiteConfig.SiteName</h1>
                <p>SiteConfig.WelcomeText</p>
            </div>
            <img class="city-logo" src="@("/images/city-logo.png")" alt="Virginia Beach City logo" />
            <img class="schoolsystem-logo" src="@("/images/schoolsystem-logo.png")"
                 alt="Virginia Beach City Public Schools logo" />

        </div>
    </header>

    <nav class="primary-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/localunits">Our Local Units</a>
        <a href="/cityprograms">Programs</a>
        <a href="#">Get Involved</a>
        <a href="#">Events</a>
        <a href="#">Sponsors</a>
        <a href="/announcements">News/Announcements</a>
        <a href="#">Awards</a>
        @if (ShowAdminLink)
        {
            <a href="/admin">Admin</a>
        }
        <AuthorizeView>
            <Authorized>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <main class="city-main">
        <div class="city-content">
            @Body
        </div>
    </main>


    <div class="footer-stack">
        <footer class="footer-nav">
            <a href="/">Home</a>
            <a href="/localunits">Our Local Units</a>
            <a href="/cityprograms">Programs</a>
            <a href="#">Get Involved</a>
            <a href="#">Events</a>
            <a href="#">Sponsors</a>
            <a href="/announcements">News/Announcements</a>
            <a href="#">Awards</a>
            <a href="/admin">Admin</a>
        </footer>

        <footer class="footer-links">
            <span>Quick Links:</span>
            <a href="https://virginiabeachcouncilpta.givebacks.com/" target="_blank" rel="noopener noreferrer">Council
                GiveBacks</a>
                <a href="https://www.facebook.com/p/Virginia-Beach-Council-of-PTAs-100064654665299/" target="_blank"
                   rel="noopener noreferrer">Facebook</a>
                <a href="https://vapta.org/" target="_blank" rel="noopener noreferrer">Virginia PTA</a>
                <a href="https://www.pta.org/" target="_blank" rel="noopener noreferrer">National PTA</a>
                <a href="https://www.vbschools.com/" target="_blank" rel="noopener noreferrer">Virginia Beach City Public
                    Schools</a>
                </footer>

                <footer class="footer-legal">
                    © Virginia Beach Council of PTAs. PTA ID# 00053175 - PTA and VBCPS trademarks are acknowledged and
                    respected.
                </footer>
            </div>
        </div>
