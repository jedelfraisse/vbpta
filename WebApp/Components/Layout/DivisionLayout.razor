@using SiteEngine.Entities
@using WebApp.Services
@inherits SiteLayoutBase
@inject SiteContext SiteContext

@code {
    private Site? Site => SiteContext.CurrentSite;

    protected override async Task OnParametersSetAsync()
    {
        // Resolve the current Division site the same way Home.razor does, so
        // the role check below is scoped to it rather than defaulting to
        // Viewer (see SiteLayoutBase.RefreshUserStateAsync).
        await SiteContext.InitializeAsync(new Uri(NavigationManager.Uri).Host);
        await RefreshUserStateAsync(Site?.Id);
    }
}
<link href="CityWideLayout.css" rel="stylesheet" />

<div class="city-shell" style="@ThemeStyle(Site)">
    <div class="theme-topbar"></div>

    <header class="masthead" role="banner">
        <div class="masthead-logos">
            @if (!string.IsNullOrWhiteSpace(Site?.LogoUrl))
            {
                <img class="site-logo" src="@Site.LogoUrl" alt="@Site.SiteName logo" />
            }
            <div class="masthead-title">
                <h1>@Site?.SiteName</h1>
            </div>
            @if (!string.IsNullOrWhiteSpace(Site?.PartnerLogoUrl))
            {
                <img class="partner-logo" src="@Site.PartnerLogoUrl" alt="@Site.SiteName partner logo" />
            }
        </div>
    </header>

    <nav class="primary-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/localunits">Our Local Units</a>
        <a href="/cityprograms">Programs</a>
        <a href="#">Get Involved</a>
        <a href="#">Events</a>
        <a href="#">Sponsors</a>
        <a href="/announcements">News/Announcements</a>
        <a href="#">Awards</a>
        @if (ShowAdminLink)
        {
            <a href="/admin">Admin</a>
        }
        <AuthorizeView>
            <Authorized>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <main class="city-main">
        <div class="city-content">
            @Body
        </div>
    </main>


    <div class="footer-stack">
        <footer class="footer-nav">
            <a href="/">Home</a>
            <a href="/localunits">Our Local Units</a>
            <a href="/cityprograms">Programs</a>
            <a href="#">Get Involved</a>
            <a href="#">Events</a>
            <a href="#">Sponsors</a>
            <a href="/announcements">News/Announcements</a>
            <a href="#">Awards</a>
            <a href="/admin">Admin</a>
        </footer>

        <footer class="footer-links">
            <span>Quick Links:</span>
            @if (!string.IsNullOrWhiteSpace(Site?.GiveBacksURL))
            {
                <a href="@Site.GiveBacksURL" target="_blank" rel="noopener noreferrer">GiveBacks</a>
            }
            @if (!string.IsNullOrWhiteSpace(Site?.FaceBookURL))
            {
                <a href="@Site.FaceBookURL" target="_blank" rel="noopener noreferrer">Facebook</a>
            }
            @if (!string.IsNullOrWhiteSpace(Site?.TwitterURL))
            {
                <a href="@Site.TwitterURL" target="_blank" rel="noopener noreferrer">Twitter</a>
            }
            @if (!string.IsNullOrWhiteSpace(Site?.InstagramURL))
            {
                <a href="@Site.InstagramURL" target="_blank" rel="noopener noreferrer">Instagram</a>
            }
            @if (!string.IsNullOrWhiteSpace(Site?.SignUpGeniusURL))
            {
                <a href="@Site.SignUpGeniusURL" target="_blank" rel="noopener noreferrer">Sign Up Genius</a>
            }
            <a href="https://vapta.org/" target="_blank" rel="noopener noreferrer">State PTA</a>
            <a href="https://www.pta.org/" target="_blank" rel="noopener noreferrer">National PTA</a>
        </footer>

        <footer class="footer-legal">
            © @Site?.SiteName
            @if (!string.IsNullOrWhiteSpace(Site?.PtaId) && Site.PtaId != "00000000")
            {
                <text>. PTA ID# @Site.PtaId</text>
            }
            - PTA trademarks are acknowledged and respected.
        </footer>

        <div class="footer-bottom"></div>
            </div>
        </div>
