@using SiteEngine.Data
@using WebApp.Services
@inherits SiteLayoutBase
@inject SetupStateService SetupState
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

@code {
    protected override async Task OnParametersSetAsync()
    {
        // PortalLayout only ever renders for the single, well-known Portal
        // site (Division/Unit sites render through their own DivisionLayout
        // / UnitLayout instead), so the role lookup is scoped to it directly
        // rather than depending on SiteContext, which isn't guaranteed to be
        // initialized yet at this point in the component tree.
        await RefreshUserStateAsync(SeedData.DefaultPortalSiteId);
    }
}

<div class="d-flex flex-column min-vh-100">

    <TopNavBar />

    <!-- Main Body -->
    <main class="container my-5 flex-grow-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container text-center small">
            © @DateTime.UtcNow.Year Delfraisse.com. All rights reserved.<br />
            PTA® and National PTA® are registered trademarks of National PTA (pta.org) and are used with respect for their ownership.<br />
            All other names, logos, and trademarks are the property of their respective owners.
        </div>
    </footer>

</div>
