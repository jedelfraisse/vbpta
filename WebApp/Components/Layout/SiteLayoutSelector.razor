@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inherits LayoutComponentBase
@inject IHttpContextAccessor Http
@inject IPlatformConfigurationService PlatformConfigurationService

@code {
    private Type _layoutType = typeof(CityWideLayout);
    private bool _isSetupMode;

    protected override async Task OnParametersSetAsync()
    {
        _isSetupMode = Http.HttpContext?.Items.ContainsKey("SetupMode") == true
            || await PlatformConfigurationService.IsInitialSetupRequiredAsync();

        if (_isSetupMode)
        {
            _layoutType = typeof(AdminLayout);
            return;
        }

        var host = new Uri(NavigationManager.Uri).Host;
        await SiteContext.InitializeAsync(host);
        _layoutType = ResolveLayoutType();
    }

    private Type ResolveLayoutType()
    {
        if (_isSetupMode)
        {
            return typeof(AdminLayout);
        }

        if (SiteContext.IsAdminContext)
        {
            return typeof(AdminLayout);
        }

        if (SiteContext.CurrentSite is null)
        {
            return typeof(AdminLayout);
        }

        return (SiteContext.CurrentSite?.IsCityWide ?? false)
            ? typeof(CityWideLayout)
            : typeof(LocalUnitLayout);
    }

}

<LayoutView Layout="_layoutType" ChildContent="@Body" />
