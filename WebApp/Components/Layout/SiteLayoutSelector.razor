@using SiteEngine.Enums
@using WebApp.Services
@using WebApp.Models
@inherits LayoutComponentBase

@inject NavigationManager Nav
@inject SetupStateService SetupState
@inject SiteContextResolver ContextResolver

@code {
    private Type _layoutType = typeof(PortalLayout);

    // Resolved in OnInitializedAsync (not OnAfterRenderAsync) so the correct
    // layout is already chosen before the very first render — including the
    // prerender pass. RuntimeSiteContext.InitializeAsync pulls its own
    // DbContext from IDbContextFactory (see LiveConnectionDbContextFactory),
    // never the shared scoped AppDbContext Identity uses, so there's no
    // concurrent-operation hazard running it this early.
    protected override async Task OnInitializedAsync()
    {
        var status = SetupState.GetStatus();

        // Setup mode should never hit this selector
        if (!status.IsFullyConfigured)
        {
            _layoutType = typeof(BasicLayout);
            return;
        }

        var ctx = ContextResolver.GetContext();

        if (ctx is RuntimeSiteContext runtime)
        {
            var host = new Uri(Nav.Uri).Host;
            await runtime.InitializeAsync(host);

            // Resolved via a non-canonical host (e.g. the PtaId fallback
            // subdomain, or an old Hostname after a custom Domain was added)?
            // Send the visitor straight to the real one instead of rendering
            // here.
            var redirectUrl = runtime.GetCanonicalRedirectUrl(host);
            if (redirectUrl is not null)
            {
                Nav.NavigateTo(redirectUrl, forceLoad: true);
                return;
            }

            _layoutType = ResolveLayoutType(runtime);
        }
    }

    private Type ResolveLayoutType(RuntimeSiteContext runtime)
    {
        var site = runtime.CurrentSite;

        if (site is null)
            return typeof(PortalLayout);

        return site.SiteType switch
        {
            SiteType.Portal => typeof(PortalLayout),
            SiteType.Division => typeof(DivisionLayout),
            SiteType.LocalUnit => typeof(UnitLayout),
            _ => typeof(PortalLayout)
        };
    }
}

<LayoutView Layout="_layoutType">
    @Body
</LayoutView>
