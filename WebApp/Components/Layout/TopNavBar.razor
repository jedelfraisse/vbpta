@using SiteEngine.Enums

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/" @onclick="CloseMenus">
            <span class="gateway-logo" aria-hidden="true"></span>
            <span class="brand-text">Central Portal</span>
        </a>

        <button class="hamburger" type="button" aria-label="Toggle navigation menu"
                aria-controls="mobile-nav-panel"
                aria-expanded="@_mobileMenuOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleMobileMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- ============================================================ -->
        <!-- DESKTOP NAV                                                   -->
        <!-- ============================================================ -->
        <nav class="nav-desktop" aria-label="Primary">
            <!-- ALWAYS VISIBLE - every role, including Anonymous -->
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/unit-sites">Unit Sites</a>
            <a class="nav-link" href="/portal-tools">Tools</a>

            <AuthorizeView>
                <Authorized>
                    <span class="nav-divider" aria-hidden="true"></span>

                    <a class="nav-link" href="/dashboard">Dashboard</a>

                    @if (ShowMySites)
                    {
                        <a class="nav-link" href="/my-sites">My Unit(s) / My Division(s)</a>
                    }

                    @if (ShowPortalAdmin)
                    {
                        <a class="nav-link" href="/portaladmin">Portal Admin</a>
                    }

                    @if (ShowAdminDropdown)
                    {
                        <div class="nav-dropdown @(_adminMenuOpen ? "open" : "")">
                            <button type="button" class="nav-link dropdown-trigger"
                                    aria-haspopup="true"
                                    aria-expanded="@_adminMenuOpen.ToString().ToLowerInvariant()"
                                    @onclick="ToggleAdminMenu">
                                @AdminMenuLabel
                                <svg class="chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" />
                                </svg>
                            </button>
                            <div class="dropdown-panel">
                                @foreach (var item in AdminItems)
                                {
                                    <a class="dropdown-item" href="@item.Href">@item.Label</a>
                                }
                            </div>
                        </div>
                    }

                    <a class="nav-link nav-logout" href="/logout">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link nav-cta" href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    @if (_adminMenuOpen && !_mobileMenuOpen)
    {
        <div class="dropdown-overlay" @onclick="CloseMenus"></div>
    }
</header>

<!-- ============================================================ -->
<!-- MOBILE SLIDE-OUT PANEL                                        -->
<!-- ============================================================ -->
<div class="mobile-overlay @(_mobileMenuOpen ? "visible" : "")" @onclick="CloseMenus"></div>
<aside id="mobile-nav-panel" class="mobile-panel @(_mobileMenuOpen ? "open" : "")"
       aria-hidden="@((!_mobileMenuOpen).ToString().ToLowerInvariant())">
    <div class="mobile-panel-header">
        <span class="gateway-logo gateway-logo-sm" aria-hidden="true"></span>
        <span class="brand-text">Central Portal</span>
        <button type="button" class="mobile-close" aria-label="Close menu" @onclick="CloseMenus">&times;</button>
    </div>

    <nav class="mobile-nav" aria-label="Primary mobile">
        <!-- ALWAYS VISIBLE - every role, including Anonymous -->
        <a class="mobile-link" href="/" @onclick="CloseMenus">Home</a>
        <a class="mobile-link" href="/unit-sites" @onclick="CloseMenus">Unit Sites</a>
        <a class="mobile-link" href="/portal-tools" @onclick="CloseMenus">Tools</a>

        <AuthorizeView>
            <Authorized>
                <div class="mobile-divider" aria-hidden="true"></div>

                <a class="mobile-link" href="/dashboard" @onclick="CloseMenus">Dashboard</a>

                @if (ShowMySites)
                {
                    <a class="mobile-link" href="/my-sites" @onclick="CloseMenus">My Unit(s) / My Division(s)</a>
                }

                @if (ShowPortalAdmin)
                {
                    <a class="mobile-link" href="/portaladmin" @onclick="CloseMenus">Portal Admin</a>
                }

                @if (ShowAdminDropdown)
                {
                    <button type="button" class="mobile-link mobile-accordion-trigger"
                            aria-expanded="@_adminMenuOpen.ToString().ToLowerInvariant()"
                            @onclick="ToggleAdminMenu">
                        @AdminMenuLabel
                        <svg class="chevron @(_adminMenuOpen ? "rotated" : "")" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" />
                        </svg>
                    </button>
                    @if (_adminMenuOpen)
                    {
                        <div class="mobile-accordion-panel">
                            @foreach (var item in AdminItems)
                            {
                                <a class="mobile-sublink" href="@item.Href" @onclick="CloseMenus">@item.Label</a>
                            }
                        </div>
                    }
                }

                <a class="mobile-link mobile-logout" href="/logout" @onclick="CloseMenus">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a class="mobile-link mobile-cta" href="/login" @onclick="CloseMenus">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</aside>

@code {
    // ------------------------------------------------------------------
    // ROLE WIRING NOTES
    //
    // <AuthorizeView> drives the Anonymous vs. Authenticated split (Login
    // vs. Dashboard/Logout), matching the pattern used in UnitLayout and
    // DivisionLayout.
    //
    // CurrentRole is a placeholder signal for which of the finer-grained
    // modes in CLAUDE.md an authenticated user is in *for the site/scope
    // currently in view*. Roles live per-site (SiteUserRole.SiteId +
    // SiteUserRole.Role), so a single global [Authorize(Roles = "...")]
    // claim can't answer "what should this bar show" on its own - resolve
    // it once in the parent layout (PortalLayout / SiteLayoutBase) by
    // looking up the current user's SiteUserRole for the active Site,
    // then pass the result down:
    //
    //   <TopNavBar CurrentRole="@CurrentPortalRole" />
    //
    // Mapping applied in this component (see CLAUDE.md section 3):
    //   null                    -> Anonymous (handled by AuthorizeView, not CurrentRole)
    //   SiteRole.Viewer         -> Authenticated, no membership ("Guest")
    //   SiteRole.Member/Officer -> Member
    //   SiteRole.SiteAdmin      -> Unit Admin
    //   SiteRole.DivisionAdmin  -> Division Admin
    //   SiteRole.SuperAdmin     -> SuperAdmin (Portal Admin + Global Admin)
    // ------------------------------------------------------------------

    [Parameter]
    public SiteRole? CurrentRole { get; set; }

    private bool _mobileMenuOpen;
    private bool _adminMenuOpen;

    private bool ShowMySites => CurrentRole is SiteRole.Member or SiteRole.Officer
        or SiteRole.SiteAdmin or SiteRole.DivisionAdmin;

    private bool ShowPortalAdmin => CurrentRole == SiteRole.SuperAdmin;

    private bool ShowAdminDropdown => CurrentRole is SiteRole.SiteAdmin
        or SiteRole.DivisionAdmin or SiteRole.SuperAdmin;

    private string AdminMenuLabel => CurrentRole switch
    {
        SiteRole.SuperAdmin => "Global Admin",
        SiteRole.DivisionAdmin => "Division Admin",
        SiteRole.SiteAdmin => "Unit Admin",
        _ => "Manage"
    };

    // Unit Admin, Division Admin, and Global Admin render through this SAME
    // dropdown markup - only the item list differs, and only one of the
    // three can be active for a given CurrentRole.
    private IReadOnlyList<(string Label, string Href)> AdminItems => CurrentRole switch
    {
        SiteRole.SiteAdmin => UnitAdminItems,
        SiteRole.DivisionAdmin => DivisionAdminItems,
        SiteRole.SuperAdmin => GlobalAdminItems,
        _ => Array.Empty<(string, string)>()
    };

    private static readonly (string Label, string Href)[] UnitAdminItems =
    {
        ("Unit Settings", "/unitadmin/settings"),
        ("Unit Admins", "/unitadmin/admins"),
        ("Site Status", "/unitadmin/site-status"),
    };

    private static readonly (string Label, string Href)[] DivisionAdminItems =
    {
        ("Manage Local Units", "/divisionadmin/units"), // extra item unique to Division Admin
        ("Division Settings", "/divisionadmin/settings"),
        ("Division Admins", "/divisionadmin/admins"),
    };

    private static readonly (string Label, string Href)[] GlobalAdminItems =
    {
        ("All Divisions", "/globaladmin/divisions"),
        ("All Units", "/globaladmin/units"),
        ("Users & Roles", "/globaladmin/users"),
        ("Portal Settings", "/globaladmin/settings"),
        ("Email / SMTP", "/globaladmin/smtp"),
        ("System Status", "/globaladmin/status"),
        ("Developer Tools", "/globaladmin/dev-tools"),
    };

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
        if (!_mobileMenuOpen)
        {
            _adminMenuOpen = false;
        }
    }

    private void ToggleAdminMenu() => _adminMenuOpen = !_adminMenuOpen;

    private void CloseMenus()
    {
        _mobileMenuOpen = false;
        _adminMenuOpen = false;
    }
}
