@using SiteEngine.Enums

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/" @onclick="CloseMenus">
            <span class="gateway-logo" aria-hidden="true"></span>
            <span class="brand-text">Central Portal</span>
        </a>

        <button class="hamburger" type="button" aria-label="Toggle navigation menu"
                aria-controls="mobile-nav-panel"
                aria-expanded="@_mobileMenuOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleMobileMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- ============================================================ -->
        <!-- DESKTOP NAV                                                   -->
        <!-- ============================================================ -->
        <nav class="nav-desktop" aria-label="Primary">
            <!-- ALWAYS VISIBLE - every role, including Anonymous -->
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/organizations">Who We Serve</a>
            <a class="nav-link" href="/unit-sites">Unit Sites</a>
            <a class="nav-link" href="/portal-tools">Tools</a>

            <AuthorizeView>
                <Authorized>
                    <span class="nav-divider" aria-hidden="true"></span>

                    <a class="nav-link" href="/dashboard">Dashboard</a>
                    @if (ShowGlobalAdminLink)
                    {
                        <a class="nav-link" href="/globaladmin">Global Admin</a>
                    }
                    <a class="nav-link nav-logout" href="/logout">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link nav-cta" href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

<!-- ============================================================ -->
<!-- MOBILE SLIDE-OUT PANEL                                        -->
<!-- ============================================================ -->
<div class="mobile-overlay @(_mobileMenuOpen ? "visible" : "")" @onclick="CloseMenus"></div>
<aside id="mobile-nav-panel" class="mobile-panel @(_mobileMenuOpen ? "open" : "")"
       aria-hidden="@((!_mobileMenuOpen).ToString().ToLowerInvariant())">
    <div class="mobile-panel-header">
        <span class="gateway-logo gateway-logo-sm" aria-hidden="true"></span>
        <span class="brand-text">Central Portal</span>
        <button type="button" class="mobile-close" aria-label="Close menu" @onclick="CloseMenus">&times;</button>
    </div>

    <nav class="mobile-nav" aria-label="Primary mobile">
        <!-- ALWAYS VISIBLE - every role, including Anonymous -->
        <a class="mobile-link" href="/" @onclick="CloseMenus">Home</a>
        <a class="mobile-link" href="/organizations" @onclick="CloseMenus">Who We Serve</a>
        <a class="mobile-link" href="/unit-sites" @onclick="CloseMenus">Unit Sites</a>
        <a class="mobile-link" href="/portal-tools" @onclick="CloseMenus">Tools</a>

        <AuthorizeView>
            <Authorized>
                <div class="mobile-divider" aria-hidden="true"></div>

                <a class="mobile-link" href="/dashboard" @onclick="CloseMenus">Dashboard</a>
                @if (ShowGlobalAdminLink)
                {
                    <a class="mobile-link" href="/globaladmin" @onclick="CloseMenus">Global Admin</a>
                }
                <a class="mobile-link mobile-logout" href="/logout" @onclick="CloseMenus">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a class="mobile-link mobile-cta" href="/login" @onclick="CloseMenus">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</aside>

@code {
    // <AuthorizeView> drives the Anonymous vs. Authenticated split (Login
    // vs. Dashboard/Logout). Dashboard is the single landing page for every
    // authenticated user regardless of role — role-specific sections
    // (Portal Admin, Global Admin, etc.) render inside it, not as separate
    // nav destinations. See Dashboard.razor / SiteRoleResolver.
    //
    // The one exception is the Global Admin link below: CurrentRole is
    // resolved by PortalLayout scoped to the Portal site specifically (this
    // component only ever renders under PortalLayout), so SiteAdmin here
    // means "Central Portal Admin" and SuperAdmin means "Global Admin" —
    // both get a shortcut straight into /globaladmin.

    [Parameter]
    public SiteRole? CurrentRole { get; set; }

    private bool ShowGlobalAdminLink => CurrentRole is SiteRole.SiteAdmin or SiteRole.SuperAdmin;

    private bool _mobileMenuOpen;

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMenus() => _mobileMenuOpen = false;
}
