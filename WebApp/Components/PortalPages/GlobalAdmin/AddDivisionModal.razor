@using SiteEngine.Enums
@using WebApp.Services
@inject SiteAdminService SiteAdminService

@if (_visible)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Division</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">@_error</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Site Name</label>
                        <input class="form-control" value="@_siteName" @oninput="OnSiteNameChanged" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">PTA ID #</label>
                        <input class="form-control" @bind="_ptaId" maxlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hostname (subdomain)</label>
                        <input class="form-control" @bind="_hostname" />
                        <div class="form-text">Auto-generated from Site Name; edit if needed.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Domain (optional)</label>
                        <input class="form-control" @bind="_domain" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="_status">
                            @foreach (var status in Enum.GetValues<SiteStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">First Contact Email (optional)</label>
                        <input class="form-control" type="email" @bind="_firstContactEmail" />
                        <div class="form-text">If provided, this person is granted Site Admin access as the primary contact.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SubmitAsync">Add Division</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCreated { get; set; }

    private bool _visible;
    private bool _saving;
    private string? _error;
    private string _siteName = "";
    private string _ptaId = "";
    private string _hostname = "";
    private string _domain = "";
    private SiteStatus _status = SiteStatus.Pending;
    private string _firstContactEmail = "";

    public void Open()
    {
        _siteName = "";
        _ptaId = "";
        _hostname = "";
        _domain = "";
        _status = SiteStatus.Pending;
        _firstContactEmail = "";
        _error = null;
        _visible = true;
    }

    private void Close() => _visible = false;

    private void OnSiteNameChanged(ChangeEventArgs e)
    {
        _siteName = e.Value?.ToString() ?? "";
        _hostname = SiteAdminService.SlugifyHostname(_siteName);
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var contactEmail = string.IsNullOrWhiteSpace(_firstContactEmail) ? null : _firstContactEmail;
        var result = await SiteAdminService.CreateDivisionAsync(_siteName, _ptaId, _hostname, _domain, _status, contactEmail);

        _saving = false;

        if (!result.Success)
        {
            _error = result.Error;
            return;
        }

        await OnCreated.InvokeAsync();

        if (result.Error is not null)
        {
            // Site was created but the first-contact setup hit a problem — keep
            // the modal open so the admin sees why before it disappears.
            _error = result.Error;
            return;
        }

        _visible = false;
    }
}
