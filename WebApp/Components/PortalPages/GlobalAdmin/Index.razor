@page "/globaladmin"
@layout GlobalAdminLayout
@using WebApp.Services
@inject DashboardService DashboardService

<PageTitle>Global Admin</PageTitle>

@if (_stats is not null)
{
    <div class="row text-center g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold">@_stats.DivisionCount</div>
            <div class="text-muted small">Divisions</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold">@_stats.UnitCount</div>
            <div class="text-muted small">Local Units</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold">@_stats.UserCount</div>
            <div class="text-muted small">Users</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold">@_stats.MembershipCount</div>
            <div class="text-muted small">Role Assignments</div>
        </div>
    </div>
}

<div class="ga-overview-cards">
    <div class="card shadow-sm ga-overview-card">
        <div class="card-body ga-overview-card">
            <h6 class="card-title">Identity &amp; Access</h6>
            <p class="card-text text-muted mb-0">Custom domains, the user directory, role &amp; permission assignments, and login analytics for everyone signed in across the portal.</p>
            <a class="btn btn-sm btn-outline-primary mt-auto" href="/globaladmin/identity">Manage Identity &amp; Access &rarr;</a>
        </div>
    </div>
    <div class="card shadow-sm ga-overview-card">
        <div class="card-body ga-overview-card">
            <h6 class="card-title">Sites &amp; Content</h6>
            <p class="card-text text-muted mb-0">Divisions and Local Units, portal branding, form templates, and submitted requests.</p>
            <a class="btn btn-sm btn-outline-primary mt-auto" href="/globaladmin/sites">Manage Sites &amp; Content &rarr;</a>
        </div>
    </div>
    <div class="card shadow-sm ga-overview-card">
        <div class="card-body ga-overview-card">
            <h6 class="card-title">System &amp; Developer</h6>
            <p class="card-text text-muted mb-0">Developer diagnostics, system logs, background jobs, feature flags, environment information, and system settings (global settings, database connection, and email server).</p>
            <a class="btn btn-sm btn-outline-primary mt-auto" href="/globaladmin/system">Manage System &amp; Developer &rarr;</a>
        </div>
    </div>
</div>

@code {
    private SystemStats? _stats;

    protected override async Task OnInitializedAsync()
    {
        _stats = await DashboardService.GetSystemStatsAsync();
    }
}
