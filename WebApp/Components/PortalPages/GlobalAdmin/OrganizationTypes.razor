@page "/globaladmin/organizations"
@layout OrganizationsLayout
@using WebApp.Services
@inject OrganizationService OrganizationService

<PageTitle>Organization Types — Global Admin</PageTitle>

<h5 class="mb-3">Organization Types</h5>
<p class="text-muted">
    The kinds of communities the portal supports — PTA today, more later. Click a type to manage its
    description, Levels, and Operational Cycles.
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h6 class="card-title">Add Organization Type</h6>
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_name" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Description</label>
                <input class="form-control" @bind="_description" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Icon Class</label>
                <input class="form-control" @bind="_iconClass" placeholder="fa-solid fa-..." />
            </div>
            <div class="col-md-1">
                <label class="form-label">Sort</label>
                <input class="form-control" type="number" @bind="_sortOrder" />
            </div>
        </div>
        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-sm" disabled="@_saving" @onclick="AddAsync">Add</button>
        </div>
    </div>
</div>

@if (!_loaded)
{
    <p class="text-muted">Loading...</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort</th>
                    <th>Levels</th>
                    <th>Organizations</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in _types)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(type.IconClass))
                            {
                                <i class="@type.IconClass" aria-hidden="true"></i>
                            }
                        </td>
                        <td><a href="@($"/globaladmin/organizations/types/{type.Id}")">@type.Name</a></td>
                        <td class="text-muted small">@type.Description</td>
                        <td>@type.SortOrder</td>
                        <td>@type.LevelCount</td>
                        <td>@type.OrganizationCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/globaladmin/organizations/types/{type.Id}")">Manage</a>
                        </td>
                    </tr>
                }
                @if (_types.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">None yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loaded;
    private bool _saving;
    private string? _error;
    private List<OrganizationTypeSummary> _types = new();

    private string _name = "";
    private string _description = "";
    private string _iconClass = "";
    private int _sortOrder;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _types = await OrganizationService.GetOrganizationTypeSummariesAsync();
        _loaded = true;
    }

    private async Task AddAsync()
    {
        _saving = true;
        _error = null;

        var result = await OrganizationService.CreateOrganizationTypeAsync(_name, _description, _iconClass, _sortOrder);
        _saving = false;

        if (!result.Success)
        {
            _error = result.Error;
            return;
        }

        _name = "";
        _description = "";
        _iconClass = "";
        _sortOrder = 0;
        await ReloadAsync();
    }
}
