@page "/globaladmin/sites/{SiteId:guid}"
@using System.Security.Claims
@using SiteEngine.Data
@using SiteEngine.Entities
@using SiteEngine.Enums
@using WebApp.Components.Layout
@using WebApp.Components.SharedPages
@using WebApp.Components.Shared
@using WebApp.Services
@inject NavigationManager NavigationManager
@inject SiteRoleResolver SiteRoleResolver
@inject SiteAdminService SiteAdminService
@inject DashboardService DashboardService
@inject FileUploadService FileUploadService

<PageTitle>Site Details</PageTitle>

<style>
    /* Self-contained "as close as we can get" masthead mockup for the
       Branding card's live preview — deliberately doesn't reuse
       CityWideLayout.css/UnitLayout.razor.css (the latter is Blazor
       component-scoped to UnitLayout.razor and can't be borrowed from here),
       but drives its colors off the exact same --primary-color/--accent-color/
       etc. custom properties via SiteLayoutBase.ThemeStyle, and mirrors the
       real masthead/footer structure (see DivisionLayout.razor/UnitLayout.razor +
       CityWideLayout.css) — a logos-only row, no site name/header text (neither
       layout renders those today), and a 4-band stacked footer, not a stripe. */
    .site-preview-shell { border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden; }
    .site-preview-topbar { height: 8px; background: var(--top-bar-color); }
    /* Both site types now render a white masthead band (see CityWideLayout.css
       .masthead / UnitLayout.razor.css .page-header) — but the two layouts put
       the nav in different places: Division has its own colored band below
       the masthead (.primary-nav, background var(--accent-color)); a Local
       Unit's nav sits inline inside the masthead itself, right of the logos,
       with --accent-color used for the link text instead (there's no separate
       band to color). The .division/.local-unit modifiers below reproduce
       that structural difference, not just a color difference. */
    .site-preview-masthead { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 12px 16px; background: #fff; border-bottom: 3px solid var(--accent-color); min-height: 30px; }
    .site-preview-masthead.division { justify-content: center; }
    .site-preview-masthead.local-unit { justify-content: space-between; }
    /* Local Unit logos: fixed 48px, not yet admin-configurable, so a plain
       CSS rule is fine. Division logos are sized per-logo (each can be a
       different width/height/fit) via an inline style computed by the exact
       same SiteLayoutBase.LogoBoxStyle() the real masthead uses — see
       SiteAdminService, so no separate CSS rule for those here. */
    .site-preview-masthead.local-unit img { height: 40px; max-width: 140px; object-fit: contain; background: #fff; border-radius: 4px; padding: 2px; }
    .site-preview-masthead.division img { background: #fff; border-radius: 4px; padding: 2px; }
    .site-preview-masthead .text-muted.small { width: 100%; text-align: center; }
    .site-preview-masthead-logos { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
    .site-preview-unit-nav { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.78rem; font-weight: 600; color: var(--accent-color); }
    .site-preview-navbar { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; padding: 8px 16px; background: var(--accent-color); font-size: 0.78rem; font-weight: 600; color: #fff; }
    .site-preview-banner { display: block; width: 100%; max-height: 90px; object-fit: cover; }
    .site-preview-body { padding: 18px 16px; color: #adb5bd; font-size: 0.8rem; min-height: 50px; background: #fff; text-align: center; }
    /* Named per-band instead of :nth-child — the footer bands are nowhere
       near the first 4 children of .site-preview-shell (topbar/masthead/
       nav/banner/body all come first), so a position-based selector never
       actually matched any of them. */
    .site-preview-footer-band { padding: 6px 16px; font-size: 0.7rem; color: rgba(255,255,255,0.75); text-align: center; }
    .site-preview-footer-band.band-1 { background: var(--footer-color-1); }
    .site-preview-footer-band.band-2 { background: var(--footer-color-2); }
    .site-preview-footer-band.band-3 { background: var(--footer-color-3); }
    .site-preview-footer-band.band-4 { background: var(--footer-color-4); height: 10px; padding: 0; }
</style>

@if (_loaded)
{
    @if (!_hasAccess)
    {
        <NoAccess />
    }
    else if (_site is null)
    {
        <div class="container">
            <p class="text-muted">That site could not be found.</p>
            <a href="/globaladmin/sites">Back to Global Admin</a>
        </div>
    }
    else
    {
        <div class="container">
            <a href="/globaladmin/sites">&laquo; Back to Global Admin</a>

            <div class="d-flex justify-content-between align-items-start mt-3 mb-4">
                <div>
                    <h1 class="mb-1">@_site.SiteName</h1>
                    <span class="badge text-bg-secondary">@_site.SiteType</span>
                    <span class="badge @StatusBadgeClass(_site.SiteStatus)">@_site.SiteStatus</span>
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(_publicUrl))
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@_publicUrl" target="_blank" rel="noopener noreferrer">Home Page</a>
                    }
                    @if (!string.IsNullOrEmpty(_adminUrl))
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@_adminUrl" target="_blank" rel="noopener noreferrer">Admin Portal</a>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-title">Summary</h6>
                    <div class="row text-center g-3">
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-bold">@(_summary?.UserCount ?? 0)</div>
                            <div class="text-muted small">Users</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-bold">@(_summary?.ChildSiteCount ?? 0)</div>
                            <div class="text-muted small">Child Sites</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-6 fw-semibold">@_site.SiteStatus</div>
                            <div class="text-muted small">Status</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-6 fw-semibold">@(string.IsNullOrWhiteSpace(_site.LastActiveYear) ? "—" : _site.LastActiveYear)</div>
                            <div class="text-muted small">Last Active Year</div>
                        </div>
                    </div>
                    <div class="text-muted small mt-3">Created @FormatDate(_site.CreatedAtUtc)</div>
                </div>
            </div>

            @* ---------------- Status ---------------- *@
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">Status</h6>
                        @if (!_editingStatus)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="EnterEditStatus">Edit</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_statusError))
                    {
                        <div class="alert alert-danger mt-2">@_statusError</div>
                    }

                    @if (!_editingStatus)
                    {
                        <span class="badge @StatusBadgeClass(_site.SiteStatus) mt-2">@_site.SiteStatus</span>
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-items-center mt-2">
                            <select class="form-select" style="max-width: 220px;" @bind="_editStatus">
                                @foreach (var status in Enum.GetValues<SiteStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@_savingStatus" @onclick="SaveStatusAsync">Save</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_savingStatus" @onclick="() => _editingStatus = false">Cancel</button>
                        </div>
                    }
                </div>
            </div>

            @* ---------------- Site Information ---------------- *@
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">Site Information</h6>
                        @if (!_editingInfo)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="EnterEditInfo">Edit</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_infoError))
                    {
                        <div class="alert alert-danger mt-2">@_infoError</div>
                    }

                    @if (!_editingInfo)
                    {
                        <dl class="row mb-0 mt-2">
                            <dt class="col-sm-3">Site Name</dt>
                            <dd class="col-sm-9">@_site.SiteName</dd>

                            <dt class="col-sm-3">PTA ID #</dt>
                            <dd class="col-sm-9">@_site.PtaId</dd>

                            <dt class="col-sm-3">Hostname</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.Hostname) ? "—" : _site.Hostname)</dd>

                            <dt class="col-sm-3">Domain</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.Domain) ? "—" : _site.Domain)</dd>

                            <dt class="col-sm-3">External URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.ExternalUrl) ? "—" : _site.ExternalUrl)</dd>

                            <dt class="col-sm-3">Last Active Year</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.LastActiveYear) ? "—" : _site.LastActiveYear)</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="row mb-3 mt-2">
                            <label class="col-sm-3 col-form-label">Site Name</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editSiteName" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">PTA ID #</label>
                            <div class="col-sm-9"><input class="form-control" maxlength="8" @bind="_editPtaId" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Hostname</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editHostname" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Domain</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editDomain" placeholder="(optional)" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">External URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editExternalUrl" placeholder="(optional)" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Last Active Year</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editLastActiveYear" placeholder="(optional)" /></div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-9 offset-sm-3 d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@_savingInfo" @onclick="SaveInfoAsync">Save</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_savingInfo" @onclick="() => _editingInfo = false">Cancel</button>
                            </div>
                        </div>
                        <p class="text-muted small">Changing Site Name regenerates the PTA logo automatically.</p>
                    }

                    <hr />

                    <dl class="row mb-0">
                        <dt class="col-sm-3">Public Home Page</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrEmpty(_publicUrl))
                            {
                                @:—
                            }
                            else
                            {
                                <a href="@_publicUrl" target="_blank" rel="noopener noreferrer">@_publicUrl/</a>
                            }
                        </dd>

                        @if (_site.ParentSite is not null)
                        {
                            <dt class="col-sm-3">Parent Division</dt>
                            <dd class="col-sm-9"><a href="@($"/globaladmin/sites/{_site.ParentSite.Id}")">@_site.ParentSite.SiteName</a></dd>
                        }

                        <dt class="col-sm-3">Contact Admin</dt>
                        <dd class="col-sm-9">@ContactAdminDisplay</dd>

                        <dt class="col-sm-3">Last Admin Login</dt>
                        <dd class="col-sm-9">@FormatDateOrDash(CurrentActivity?.LastAdminLogin)</dd>

                        <dt class="col-sm-3">Last Login</dt>
                        <dd class="col-sm-9">@FormatDateOrDash(CurrentActivity?.LastLogin)</dd>

                        <dt class="col-sm-3">Created</dt>
                        <dd class="col-sm-9">@FormatDate(_site.CreatedAtUtc)</dd>

                        <dt class="col-sm-3">Last Updated</dt>
                        <dd class="col-sm-9">@FormatDate(_site.UpdatedAtUtc)</dd>
                    </dl>
                </div>
            </div>

            @* ---------------- Branding ---------------- *@
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">Branding</h6>
                        @if (!_editingBranding)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="EnterEditBranding">Edit</button>
                        }
                    </div>
                    <p class="small mb-2">
                        <a href="https://www.pta.org/docs/default-source/files/runyourpta/branding/2026/pta_brandkit_2026_mainbrand.pdf" target="_blank" rel="noopener noreferrer">
                            <i class="fa-solid fa-file-pdf"></i> National PTA Brand Kit (2026, PDF)
                        </a>
                    </p>

                    <div class="mb-3 mt-2">
                        @if (!string.IsNullOrWhiteSpace(_site.LogoUrl))
                        {
                            <img src="@_site.LogoUrl" alt="@_site.SiteName logo" class="img-thumbnail d-block mb-2" style="max-height:100px;max-width:320px;object-fit:contain;" />
                        }
                        <button type="button" class="btn btn-sm btn-primary" disabled="@_generatingLogo" @onclick="GenerateLogoAsync">
                            @(string.IsNullOrWhiteSpace(_site.LogoUrl) ? "Generate PTA Logo" : "Regenerate PTA Logo")
                        </button>
                        @if (_generatingLogo)
                        {
                            <span class="text-muted small ms-2">Generating…</span>
                        }
                        @if (!string.IsNullOrEmpty(_logoError))
                        {
                            <div class="text-danger small mt-2">@_logoError</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_brandingError))
                    {
                        <div class="alert alert-danger">@_brandingError</div>
                    }

                    @if (!_editingBranding)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Banner</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.BannerUrl)</dd>

                            <dt class="col-sm-3">Header Text</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.HeaderText) ? "—" : _site.HeaderText)</dd>

                            <dt class="col-sm-3">Top Bar Color</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.TopBarColor) <span class="text-muted small">— the thin strip along the very top of the page</span></dd>

                            <dt class="col-sm-3">Navigation Color</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.AccentColor) <span class="text-muted small">— the nav bar (Division) or masthead border/nav text (Local Unit)</span></dd>

                            <dt class="col-sm-3">Highlight Color</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.PrimaryColor) <span class="text-muted small">— sub-nav tab highlight (Division only, for now)</span></dd>

                            <dt class="col-sm-3">Footer Navigation</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.FooterColor1)</dd>

                            <dt class="col-sm-3">Footer Quick Links</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.FooterColor2)</dd>

                            <dt class="col-sm-3">Footer Legal</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.FooterColor3)</dd>

                            <dt class="col-sm-3">Footer Bottom Strip</dt>
                            <dd class="col-sm-9">@ColorSwatch(_site.FooterColor4)</dd>

                            <dt class="col-sm-3">PTA Logo Variant</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.PTALogoVariantUrl)</dd>

                            <dt class="col-sm-3">District Logo</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.DistrictLogoUrl)</dd>

                            @if (_site.SiteType == SiteType.LocalUnit)
                            {
                                <dt class="col-sm-3">School Crest</dt>
                                <dd class="col-sm-9">@BrandingThumb(_site.SchoolCrestUrl)</dd>
                            }

                            <dt class="col-sm-3">Partner Logo</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.PartnerLogoUrl)</dd>

                            @if (_site.SiteType == SiteType.Division)
                            {
                                <dt class="col-sm-3">Masthead Logo Size</dt>
                                <dd class="col-sm-9">
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0">
                                            <thead><tr><th>Logo</th><th>Width</th><th>Height</th><th>Fit</th></tr></thead>
                                            <tbody>
                                                <tr><td>Default (unset logos)</td><td>@(_site.MastheadLogoDefaultWidth?.ToString() ?? "260") px</td><td>@(_site.MastheadLogoDefaultHeight?.ToString() ?? "110") px</td><td>—</td></tr>
                                                <tr><td>Generated PTA Logo</td><td>@LogoSizeCell(_site.GeneratedLogoWidth, _site.MastheadLogoDefaultWidth, 260)</td><td>@LogoSizeCell(_site.GeneratedLogoHeight, _site.MastheadLogoDefaultHeight, 110)</td><td>@(_site.GeneratedLogoPreserveAspectRatio ? "Keep ratio" : "Stretch")</td></tr>
                                                <tr><td>PTA Logo Variant</td><td>@LogoSizeCell(_site.PtaVariantLogoWidth, _site.MastheadLogoDefaultWidth, 260)</td><td>@LogoSizeCell(_site.PtaVariantLogoHeight, _site.MastheadLogoDefaultHeight, 110)</td><td>@(_site.PtaVariantLogoPreserveAspectRatio ? "Keep ratio" : "Stretch")</td></tr>
                                                <tr><td>District Logo</td><td>@LogoSizeCell(_site.DistrictLogoWidth, _site.MastheadLogoDefaultWidth, 260)</td><td>@LogoSizeCell(_site.DistrictLogoHeight, _site.MastheadLogoDefaultHeight, 110)</td><td>@(_site.DistrictLogoPreserveAspectRatio ? "Keep ratio" : "Stretch")</td></tr>
                                                <tr><td>Partner Logo</td><td>@LogoSizeCell(_site.PartnerLogoWidth, _site.MastheadLogoDefaultWidth, 260)</td><td>@LogoSizeCell(_site.PartnerLogoHeight, _site.MastheadLogoDefaultHeight, 110)</td><td>@(_site.PartnerLogoPreserveAspectRatio ? "Keep ratio" : "Stretch")</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="text-muted small mb-0">Blank cells use the default box above.</p>
                                </dd>
                            }

                            <dt class="col-sm-3">Menu Background</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.MenuBackgroundImageUrl)</dd>

                            <dt class="col-sm-3">Page Background</dt>
                            <dd class="col-sm-9">@BrandingThumb(_site.PageBackgroundImageUrl)</dd>
                        </dl>
                    }
                    else
                    {
                        <ImageUploadField Label="Banner" CurrentUrl="@_editBannerUrl" UploadFolder="site-banners" OnUploaded="@(url => _editBannerUrl = url)" />

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Header Text</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editHeaderText" /></div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Top Bar Color</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editTopBarColor" /></div>
                        </div>
                        <p class="text-muted small mb-3">The thin strip along the very top of the page.</p>

                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Navigation Color</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editAccentColor" /></div>
                        </div>
                        <p class="text-muted small mb-3">The nav bar background (Division) or the masthead border and nav link text (Local Unit).</p>

                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Highlight Color</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editPrimaryColor" /></div>
                        </div>
                        <p class="text-muted small mb-3">Currently only visible as the active sub-nav tab on Division pages.</p>

                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Footer Navigation</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editFooterColor1" /></div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Footer Quick Links</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editFooterColor2" /></div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <label class="col-sm-3 col-form-label">Footer Legal</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editFooterColor3" /></div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-3 col-form-label">Footer Bottom Strip</label>
                            <div class="col-sm-9"><input type="color" class="form-control form-control-color" @bind="_editFooterColor4" /></div>
                        </div>

                        @if (_site.SiteType == SiteType.Division)
                        {
                            <label class="form-label fw-semibold mt-2">Masthead Logos</label>
                            <p class="text-muted small">
                                Upload each logo and size it right here. Width/Height default to the image's own
                                pixel size the first time you upload it (or open this form) — adjust from there.
                                Leave a logo's boxes blank to fall back to the default box below. "Keep ratio"
                                scales the logo down to fit without distorting it (it may not fill the whole box);
                                unchecked stretches it to fill the box exactly.
                            </p>
                            @if (_logoSizeResetError is not null)
                            {
                                <div class="alert alert-warning py-1 px-2 small">@_logoSizeResetError</div>
                            }
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle">
                                    <thead><tr><th>Logo</th><th>Width (px)</th><th>Height (px)</th><th>Keep ratio</th><th></th></tr></thead>
                                    <tbody>
                                        <tr>
                                            <td>Default box<br /><span class="text-muted small">(unset logos)</span></td>
                                            <td><input type="number" min="20" max="400" class="form-control form-control-sm" placeholder="260" @bind="_editMastheadLogoDefaultWidth" /></td>
                                            <td><input type="number" min="20" max="400" class="form-control form-control-sm" placeholder="110" @bind="_editMastheadLogoDefaultHeight" /></td>
                                            <td>—</td>
                                            <td></td>
                                        </tr>

                                        <tr>
                                            <td rowspan="2">Generated<br />PTA Logo</td>
                                            <td colspan="4">
                                                @if (!string.IsNullOrWhiteSpace(_site.LogoUrl))
                                                {
                                                    <img src="@_site.LogoUrl" alt="" class="img-thumbnail" style="max-height:48px;max-width:160px;object-fit:contain;" />
                                                }
                                                <span class="text-muted small">Generated above — not uploaded here.</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><input type="number" min="20" max="400" class="form-control form-control-sm" @bind:get="_editGeneratedLogoWidth" @bind:set="OnGeneratedLogoWidthChanged" /></td>
                                            <td><input type="number" min="20" max="400" class="form-control form-control-sm" @bind:get="_editGeneratedLogoHeight" @bind:set="OnGeneratedLogoHeightChanged" /></td>
                                            <td><input type="checkbox" class="form-check-input" @bind="_editGeneratedLogoPreserveAspectRatio" /></td>
                                            <td><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetGeneratedLogoSize">Use Original Size</button></td>
                                        </tr>

                                        <tr>
                                            <td rowspan="2">PTA Logo<br />Variant</td>
