    // View-mode table cell: shows the per-logo override if set, otherwise
    // the site's own default box, otherwise the hardcoded fallback —
    // mirrors the same 3-level fallback SiteLayoutBase.LogoBoxStyle applies
    // on the real page, so this always describes what's actually rendered.
    private static string LogoSizeCell(int? logoValue, int? siteDefault, int hardcodedFallback) =>
        logoValue?.ToString() ?? (siteDefault?.ToString() ?? $"({hardcodedFallback})");

    private static string NormalizeColor(string? hex) =>
        !string.IsNullOrWhiteSpace(hex) && hex.Length == 7 && hex[0] == '#' ? hex : "#000000";

    private static MarkupString BrandingThumb(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return new MarkupString("—");

        var src = System.Net.WebUtility.HtmlEncode(url);
        return new MarkupString(
            "<div class=\"d-flex align-items-center gap-2\">" +
            $"<img src=\"{src}\" alt=\"\" class=\"img-thumbnail\" style=\"max-height:60px;max-width:200px;object-fit:contain;\" />" +
            "<span class=\"text-muted small\">Uploaded</span></div>");
    }

    private static MarkupString ColorSwatch(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex))
            return new MarkupString("—");

        return new MarkupString(
            $"<span style=\"display:inline-block;width:14px;height:14px;border:1px solid #ced4da;border-radius:3px;background:{hex};vertical-align:middle;\"></span> {hex}");
    }

    private async Task GenerateLogoAsync()
    {
        if (_site is null)
            return;

        _generatingLogo = true;
        _logoError = null;

        var result = await SiteAdminService.GeneratePtaLogoAsync(_site.Id);

        _generatingLogo = false;

        if (!result.Success)
        {
            _logoError = result.Error;
            return;
        }

        _site.LogoUrl = result.Site!.LogoUrl;
    }

    // ---- Social Links ----
    private void EnterEditSocial()
    {
        _editFacebookUrl = _site!.FaceBookURL;
        _editGiveBacksUrl = _site.GiveBacksURL;
        _editInstagramUrl = _site.InstagramURL;
        _editTwitterUrl = _site.TwitterURL;
        _editSignUpGeniusUrl = _site.SignUpGeniusURL;
        _socialError = null;
        _editingSocial = true;
    }

    private async Task SaveSocialAsync()
    {
        if (_site is null)
            return;

        _savingSocial = true;
        _socialError = null;

        var result = await SiteAdminService.UpdateSocialLinksAsync(
            _site.Id, _editFacebookUrl, _editGiveBacksUrl, _editInstagramUrl, _editTwitterUrl, _editSignUpGeniusUrl);

        _savingSocial = false;

        if (!result.Success)
        {
            _socialError = result.Error;
            return;
        }

        _site = result.Site;
        _editingSocial = false;
    }

    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private static string FormatDateOrDash(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "—";

    private static string StatusBadgeClass(SiteStatus status) => status switch
    {
        SiteStatus.Pending => "text-bg-warning",
        SiteStatus.MembersOnly => "text-bg-info",
        SiteStatus.Active => "text-bg-success",
        SiteStatus.Inactive => "text-bg-secondary",
        SiteStatus.Archived => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}
