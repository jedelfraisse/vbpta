                                }
                                @if (!string.IsNullOrWhiteSpace(previewSite.PTALogoVariantUrl))
                                {
                                    <img src="@previewSite.PTALogoVariantUrl" alt="PTA logo variant"
                                         style="@(_site.SiteType == SiteType.Division ? SiteLayoutBase.LogoBoxStyle(previewSite, previewSite.PtaVariantLogoWidth, previewSite.PtaVariantLogoHeight, previewSite.PtaVariantLogoPreserveAspectRatio) : "")" />
                                }
                                @if (_site.SiteType == SiteType.LocalUnit && !string.IsNullOrWhiteSpace(previewSite.ResolvedSchoolCrestUrl()))
                                {
                                    <img src="@previewSite.ResolvedSchoolCrestUrl()" alt="School crest" />
                                }
                                @if (!string.IsNullOrWhiteSpace(previewSite.ResolvedDistrictLogoUrl()))
                                {
                                    <img src="@previewSite.ResolvedDistrictLogoUrl()" alt="District logo"
                                         style="@(_site.SiteType == SiteType.Division ? SiteLayoutBase.LogoBoxStyle(previewSite, previewSite.DistrictLogoWidth, previewSite.DistrictLogoHeight, previewSite.DistrictLogoPreserveAspectRatio) : "")" />
                                }
                                @if (!string.IsNullOrWhiteSpace(previewSite.ResolvedPartnerLogoUrl()))
                                {
                                    <img src="@previewSite.ResolvedPartnerLogoUrl()" alt="Partner logo"
                                         style="@(_site.SiteType == SiteType.Division ? SiteLayoutBase.LogoBoxStyle(previewSite, previewSite.PartnerLogoWidth, previewSite.PartnerLogoHeight, previewSite.PartnerLogoPreserveAspectRatio) : "")" />
                                }
                                @if (string.IsNullOrWhiteSpace(previewSite.LogoUrl) && string.IsNullOrWhiteSpace(previewSite.PTALogoVariantUrl)
                                    && string.IsNullOrWhiteSpace(previewSite.ResolvedDistrictLogoUrl()) && string.IsNullOrWhiteSpace(previewSite.ResolvedPartnerLogoUrl()))
                                {
                                    <span class="text-muted small">No logos yet — this row is empty on the real site too.</span>
                                }
                            </div>
                            @if (_site.SiteType == SiteType.LocalUnit)
                            {
                                <nav class="site-preview-unit-nav"><span>Home</span><span>Announcements</span></nav>
                            }
                        </div>
                        @if (_site.SiteType == SiteType.Division)
                        {
                            <div class="site-preview-navbar">
                                <span>Home</span><span>Our Local Units</span><span>Programs</span><span>Events</span><span>News/Announcements</span>
                            </div>
                        }
                        @if (_site.SiteType == SiteType.LocalUnit && !string.IsNullOrWhiteSpace(previewSite.BannerUrl))
                        {
                            <img class="site-preview-banner" src="@previewSite.BannerUrl" alt="Banner" />
                        }
                        <div class="site-preview-body">Page content goes here…</div>
                        <div class="site-preview-footer-band band-1">@FooterNavText()</div>
                        <div class="site-preview-footer-band band-2">@FooterQuickLinksText()</div>
                        <div class="site-preview-footer-band band-3">@FooterLegalText()</div>
                        <div class="site-preview-footer-band band-4"></div>
                    </div>
                </div>
            </div>

            @* ---------------- Social Links ---------------- *@
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">Social Links</h6>
                        @if (!_editingSocial)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="EnterEditSocial">Edit</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_socialError))
                    {
                        <div class="alert alert-danger mt-2">@_socialError</div>
                    }

                    @if (!_editingSocial)
                    {
                        <dl class="row mb-0 mt-2">
                            <dt class="col-sm-3">Facebook URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.FaceBookURL) ? "—" : _site.FaceBookURL)</dd>

                            <dt class="col-sm-3">GiveBacks URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.GiveBacksURL) ? "—" : _site.GiveBacksURL)</dd>

                            <dt class="col-sm-3">Instagram URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.InstagramURL) ? "—" : _site.InstagramURL)</dd>

                            <dt class="col-sm-3">Twitter/X URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.TwitterURL) ? "—" : _site.TwitterURL)</dd>

                            <dt class="col-sm-3">Sign Up Genius URL</dt>
                            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_site.SignUpGeniusURL) ? "—" : _site.SignUpGeniusURL)</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="row mb-3 mt-2">
                            <label class="col-sm-3 col-form-label">Facebook URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editFacebookUrl" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">GiveBacks URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editGiveBacksUrl" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Instagram URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editInstagramUrl" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Twitter/X URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editTwitterUrl" /></div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Sign Up Genius URL</label>
                            <div class="col-sm-9"><input class="form-control" @bind="_editSignUpGeniusUrl" /></div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-primary" disabled="@_savingSocial" @onclick="SaveSocialAsync">Save</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_savingSocial" @onclick="() => _editingSocial = false">Cancel</button>
                        </div>
                    }
                </div>
            </div>

            @if (_site.SiteType == SiteType.Division)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h6 class="card-title mb-0">Local Units</h6>
                            <div class="d-flex align-items-center gap-2">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                        Status (@_selectedUnitStatuses.Count)
                                    </button>
                                    <ul class="dropdown-menu p-2">
                                        @foreach (var status in _statusOptions)
                                        {
                                            <li>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="@($"unit-status-filter-{status}")"
                                                           checked="@_selectedUnitStatuses.Contains(status)"
                                                           @onchange="e => ToggleUnitStatus(status, e.Value)" />
                                                    <label class="form-check-label" for="@($"unit-status-filter-{status}")">@status</label>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _addLocalUnitModal?.Open(_site.Id)">
                                    + Local Unit
                                </button>
                            </div>
                        </div>
                        @{ var visibleChildUnits = FilteredChildUnits().ToList(); }
                        <ul class="list-group list-group-flush">
                            @foreach (var unit in visibleChildUnits)
                            {
                                <li class="list-group-item">
                                    <LocalUnitRow Unit="unit" PortalDomain="@_portalDomain" SiteActivity="_siteActivity.GetValueOrDefault(unit.Id)" />
                                </li>
                            }
                            @if (visibleChildUnits.Count == 0)
                            {
                                <li class="list-group-item text-muted">No Local Units yet.</li>
                            }
                        </ul>
                    </div>
                </div>

                <AddLocalUnitModal @ref="_addLocalUnitModal" Divisions="_allDivisions" OnCreated="ReloadSiteAsync" />
            }
        </div>
    }
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _hasAccess;
    private Site? _site;
    private string _adminUrl = string.Empty;
    private string _publicUrl = string.Empty;
    private string _portalDomain = string.Empty;
    private SiteSummary? _summary;
    private Dictionary<Guid, SiteActivity> _siteActivity = new();

    private SiteActivity? CurrentActivity => _site is null ? null : _siteActivity.GetValueOrDefault(_site.Id);
    private string ContactAdminDisplay => CurrentActivity?.ContactAdminEmail is { Length: > 0 } email
        ? (string.IsNullOrWhiteSpace(CurrentActivity.ContactAdminName) ? email : $"{CurrentActivity.ContactAdminName} ({email})")
        : "—";

    // ---- Status ----
    private bool _editingStatus;
    private SiteStatus _editStatus;
    private bool _savingStatus;
    private string? _statusError;

    // ---- Site Information ----
    private bool _editingInfo;
    private string _editSiteName = string.Empty;
    private string _editPtaId = string.Empty;
    private string _editHostname = string.Empty;
    private string _editDomain = string.Empty;
    private string _editExternalUrl = string.Empty;
    private string _editLastActiveYear = string.Empty;
    private bool _savingInfo;
    private string? _infoError;

    // ---- Branding ----
    private bool _editingBranding;
    private string _editBannerUrl = string.Empty;
    private string _editHeaderText = string.Empty;
    private string _editPrimaryColor = SiteThemeDefaults.PrimaryColor;
    private string _editAccentColor = SiteThemeDefaults.AccentColor;
    private string _editTopBarColor = SiteThemeDefaults.TopBarColor;
    private string _editFooterColor1 = SiteThemeDefaults.FooterColor1;
    private string _editFooterColor2 = SiteThemeDefaults.FooterColor2;
    private string _editFooterColor3 = SiteThemeDefaults.FooterColor3;
    private string _editFooterColor4 = SiteThemeDefaults.FooterColor4;
    private string _editPtaLogoVariantUrl = string.Empty;
    private string _editDistrictLogoUrl = string.Empty;
    private string _editSchoolCrestUrl = string.Empty;
    private string _editPartnerLogoUrl = string.Empty;
    private string _editMenuBackgroundImageUrl = string.Empty;
    private string _editPageBackgroundImageUrl = string.Empty;
    private int? _editMastheadLogoDefaultWidth;
    private int? _editMastheadLogoDefaultHeight;
    private int? _editGeneratedLogoWidth;
    private int? _editGeneratedLogoHeight;
    private bool _editGeneratedLogoPreserveAspectRatio = true;
    private int? _editPtaVariantLogoWidth;
    private int? _editPtaVariantLogoHeight;
    private bool _editPtaVariantLogoPreserveAspectRatio = true;
    private int? _editDistrictLogoWidth;
    private int? _editDistrictLogoHeight;
    private bool _editDistrictLogoPreserveAspectRatio = true;
    private int? _editPartnerLogoWidth;
    private int? _editPartnerLogoHeight;
    private bool _editPartnerLogoPreserveAspectRatio = true;
    private bool _savingBranding;
    private string? _brandingError;

    private bool _generatingLogo;
    private string? _logoError;

    // ---- Social Links ----
    private bool _editingSocial;
    private string _editFacebookUrl = string.Empty;
    private string _editGiveBacksUrl = string.Empty;
    private string _editInstagramUrl = string.Empty;
    private string _editTwitterUrl = string.Empty;
    private string _editSignUpGeniusUrl = string.Empty;
    private bool _savingSocial;
    private string? _socialError;

    private static readonly SiteStatus[] _statusOptions = Enum.GetValues<SiteStatus>();

    // Same automatic exclusion as the Sites tab — Inactive/Archived Local
    // Units start hidden, opt back in via the checkboxes.
    private HashSet<SiteStatus> _selectedUnitStatuses = new(
        _statusOptions.Where(s => s != SiteStatus.Inactive && s != SiteStatus.Archived));

    private List<Site> _allDivisions = new();
    private AddLocalUnitModal? _addLocalUnitModal;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        var identityUserId = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        if (string.IsNullOrEmpty(identityUserId))
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var portalRole = await SiteRoleResolver.ResolveAsync(identityUserId, SeedData.DefaultPortalSiteId);
        _hasAccess = portalRole == SiteRole.SuperAdmin;

        if (_hasAccess)
        {
            var config = await DashboardService.GetPortalConfigAsync();
            _portalDomain = config?.PortalDomain?.Trim() ?? string.Empty;

            await ReloadSiteAsync();
        }

        _loaded = true;
    }

    private async Task ReloadSiteAsync()
    {
        _site = await SiteAdminService.GetSiteDetailAsync(SiteId);
        if (_site is null)
            return;

        _adminUrl = SiteUrlHelper.BuildAdminUrl(_site, _portalDomain);
        _publicUrl = SiteUrlHelper.BuildPublicUrl(_site, _portalDomain);
        _summary = await SiteAdminService.GetSiteSummaryAsync(_site.Id);

        var activitySiteIds = _site.ChildSites.Select(c => c.Id).Append(_site.Id).ToList();
        _siteActivity = await SiteAdminService.GetSiteActivityAsync(activitySiteIds);

        if (_site.SiteType == SiteType.Division)
            _allDivisions = await SiteAdminService.GetAllDivisionsAsync();
    }

    private void ToggleUnitStatus(SiteStatus status, object? value)
    {
        if (value is true)
            _selectedUnitStatuses.Add(status);
        else
            _selectedUnitStatuses.Remove(status);
    }

    private IEnumerable<Site> FilteredChildUnits() => _site!.ChildSites
        .Where(u => _selectedUnitStatuses.Contains(u.SiteStatus))
        .OrderBy(u => u.SiteName, StringComparer.OrdinalIgnoreCase);

    // ---- Status ----
    private void EnterEditStatus()
    {
        _editStatus = _site!.SiteStatus;
        _statusError = null;
        _editingStatus = true;
    }

    private async Task SaveStatusAsync()
    {
        if (_site is null)
            return;

        _savingStatus = true;
        _statusError = null;

        var result = await SiteAdminService.UpdateSiteStatusAsync(_site.Id, _editStatus);

        _savingStatus = false;

        if (!result.Success)
        {
            _statusError = result.Error;
            return;
        }

        _site.SiteStatus = result.Site!.SiteStatus;
        _editingStatus = false;
    }

    // ---- Site Information ----
    private void EnterEditInfo()
    {
        _editSiteName = _site!.SiteName;
        _editPtaId = _site.PtaId;
        _editHostname = _site.Hostname;
        _editDomain = _site.Domain;
        _editExternalUrl = _site.ExternalUrl ?? string.Empty;
        _editLastActiveYear = _site.LastActiveYear ?? string.Empty;
        _infoError = null;
        _editingInfo = true;
    }

    private async Task SaveInfoAsync()
    {
        if (_site is null)
            return;

        _savingInfo = true;
        _infoError = null;

        var infoResult = await SiteAdminService.UpdateSiteInfoAsync(
            _site.Id, _editSiteName, _editPtaId, _editExternalUrl, _editLastActiveYear);

        if (!infoResult.Success)
        {
            _infoError = infoResult.Error;
            _savingInfo = false;
            return;
        }

        var domainResult = await SiteAdminService.UpdateDomainSettingsAsync(_site.Id, _editHostname, _editDomain);

        _savingInfo = false;

        // Site Name/PTA ID/etc. already saved above even if the domain half
        // fails (e.g. hostname taken) — reload so the view reflects that
        // partial save instead of silently discarding it, then let the admin
        // fix just the domain field and retry.
        await ReloadSiteAsync();

        if (!domainResult.Success)
        {
            _infoError = domainResult.Error;
            return;
        }

        _editingInfo = false;
    }

    // ---- Branding ----
    private void EnterEditBranding()
    {
        _editBannerUrl = _site!.BannerUrl;
        _editHeaderText = _site.HeaderText;
        _editPrimaryColor = NormalizeColor(_site.PrimaryColor ?? _site.ResolvedPrimaryColor());
        _editAccentColor = NormalizeColor(_site.AccentColor ?? _site.ResolvedAccentColor());
        _editTopBarColor = NormalizeColor(_site.TopBarColor ?? _site.ResolvedTopBarColor());
        _editFooterColor1 = NormalizeColor(_site.FooterColor1 ?? _site.ResolvedFooterColor1());
        _editFooterColor2 = NormalizeColor(_site.FooterColor2 ?? _site.ResolvedFooterColor2());
        _editFooterColor3 = NormalizeColor(_site.FooterColor3 ?? _site.ResolvedFooterColor3());
        _editFooterColor4 = NormalizeColor(_site.FooterColor4 ?? _site.ResolvedFooterColor4());
        _editPtaLogoVariantUrl = _site.PTALogoVariantUrl ?? string.Empty;
        _editDistrictLogoUrl = _site.DistrictLogoUrl ?? string.Empty;
        _editSchoolCrestUrl = _site.SchoolCrestUrl ?? string.Empty;
        _editPartnerLogoUrl = _site.PartnerLogoUrl ?? string.Empty;
        _editMenuBackgroundImageUrl = _site.MenuBackgroundImageUrl ?? string.Empty;
        _editPageBackgroundImageUrl = _site.PageBackgroundImageUrl ?? string.Empty;
        _editMastheadLogoDefaultWidth = _site.MastheadLogoDefaultWidth;
        _editMastheadLogoDefaultHeight = _site.MastheadLogoDefaultHeight;
        _editGeneratedLogoWidth = _site.GeneratedLogoWidth;
        _editGeneratedLogoHeight = _site.GeneratedLogoHeight;
        _editGeneratedLogoPreserveAspectRatio = _site.GeneratedLogoPreserveAspectRatio;
        _editPtaVariantLogoWidth = _site.PtaVariantLogoWidth;
        _editPtaVariantLogoHeight = _site.PtaVariantLogoHeight;
        _editPtaVariantLogoPreserveAspectRatio = _site.PtaVariantLogoPreserveAspectRatio;
        _editDistrictLogoWidth = _site.DistrictLogoWidth;
        _editDistrictLogoHeight = _site.DistrictLogoHeight;
        _editDistrictLogoPreserveAspectRatio = _site.DistrictLogoPreserveAspectRatio;
        _editPartnerLogoWidth = _site.PartnerLogoWidth;
        _editPartnerLogoHeight = _site.PartnerLogoHeight;
        _editPartnerLogoPreserveAspectRatio = _site.PartnerLogoPreserveAspectRatio;

        // A logo that's never had a size saved gets one now — its own actual
        // pixel dimensions, not the generic default box — so the fields open
        // with a real, meaningful starting point instead of blank inputs.
        // Only when BOTH are unset: don't clobber a deliberate partial
        // choice (e.g. an admin who set Width and left Height to inherit).
        if (_editGeneratedLogoWidth is null && _editGeneratedLogoHeight is null)
            ApplyNaturalSize(_site.LogoUrl, ref _editGeneratedLogoWidth, ref _editGeneratedLogoHeight);
        if (_editPtaVariantLogoWidth is null && _editPtaVariantLogoHeight is null)
            ApplyNaturalSize(_site.PTALogoVariantUrl, ref _editPtaVariantLogoWidth, ref _editPtaVariantLogoHeight);
        if (_editDistrictLogoWidth is null && _editDistrictLogoHeight is null)
            ApplyNaturalSize(_site.DistrictLogoUrl, ref _editDistrictLogoWidth, ref _editDistrictLogoHeight);
        if (_editPartnerLogoWidth is null && _editPartnerLogoHeight is null)
            ApplyNaturalSize(_site.PartnerLogoUrl, ref _editPartnerLogoWidth, ref _editPartnerLogoHeight);

        _brandingError = null;
        _logoSizeResetError = null;
        _editingBranding = true;
    }

    // Backs the Width/Height inputs' @bind:set — when Keep Ratio is on,
    // changing one recomputes the other off the CURRENT pair (whatever's in
    // the boxes right now, whether that's the image's natural size or an
    // earlier custom value) rather than some separately-remembered "original"
    // ratio, matching how a typical image-size dialog's aspect lock behaves.
    // With Keep Ratio off, or when the current pair has nothing to compute a
    // ratio from yet (either box empty/zero), the two fields are simply
    // independent — the new value is stored as-is, the other untouched.
    private static void LinkedWidthChanged(int? newWidth, ref int? width, ref int? height, bool preserveAspectRatio)
    {
        if (preserveAspectRatio && width is > 0 && height is > 0 && newWidth is > 0)
            height = (int)Math.Round(newWidth.Value * (double)height.Value / width.Value);

        width = newWidth;
    }

    private static void LinkedHeightChanged(int? newHeight, ref int? width, ref int? height, bool preserveAspectRatio)
    {
        if (preserveAspectRatio && width is > 0 && height is > 0 && newHeight is > 0)
            width = (int)Math.Round(newHeight.Value * (double)width.Value / height.Value);

        height = newHeight;
    }

    private void OnGeneratedLogoWidthChanged(int? v) => LinkedWidthChanged(v, ref _editGeneratedLogoWidth, ref _editGeneratedLogoHeight, _editGeneratedLogoPreserveAspectRatio);
    private void OnGeneratedLogoHeightChanged(int? v) => LinkedHeightChanged(v, ref _editGeneratedLogoWidth, ref _editGeneratedLogoHeight, _editGeneratedLogoPreserveAspectRatio);

    private void OnPtaVariantLogoWidthChanged(int? v) => LinkedWidthChanged(v, ref _editPtaVariantLogoWidth, ref _editPtaVariantLogoHeight, _editPtaVariantLogoPreserveAspectRatio);
    private void OnPtaVariantLogoHeightChanged(int? v) => LinkedHeightChanged(v, ref _editPtaVariantLogoWidth, ref _editPtaVariantLogoHeight, _editPtaVariantLogoPreserveAspectRatio);

    private void OnDistrictLogoWidthChanged(int? v) => LinkedWidthChanged(v, ref _editDistrictLogoWidth, ref _editDistrictLogoHeight, _editDistrictLogoPreserveAspectRatio);
    private void OnDistrictLogoHeightChanged(int? v) => LinkedHeightChanged(v, ref _editDistrictLogoWidth, ref _editDistrictLogoHeight, _editDistrictLogoPreserveAspectRatio);

    private void OnPartnerLogoWidthChanged(int? v) => LinkedWidthChanged(v, ref _editPartnerLogoWidth, ref _editPartnerLogoHeight, _editPartnerLogoPreserveAspectRatio);
    private void OnPartnerLogoHeightChanged(int? v) => LinkedHeightChanged(v, ref _editPartnerLogoWidth, ref _editPartnerLogoHeight, _editPartnerLogoPreserveAspectRatio);

    private bool ApplyNaturalSize(string? url, ref int? width, ref int? height)
    {
        var dimensions = FileUploadService.TryGetImageDimensions(url);
        if (dimensions is null)
            return false;

        width = dimensions.Value.Width;
        height = dimensions.Value.Height;
        return true;
    }

    // Backs each logo row's "Use Original Size" button — re-reads the
    // CURRENT image (whatever's in the edit field right now, which may be a
    // file just uploaded this session and not yet saved) and overwrites
    // Width/Height with its real pixels, same as a fresh upload does
    // automatically. Uses _site.LogoUrl for the generated logo since that
    // one has no edit-field counterpart (it's never hand-uploaded here).
    private string? _logoSizeResetError;

    private void ResetLogoSize(string logoName, string? url, ref int? width, ref int? height)
    {
        _logoSizeResetError = ApplyNaturalSize(url, ref width, ref height)
            ? null
            : $"Couldn't read {logoName}'s size — is there an image uploaded, and is it a format with a fixed pixel size (not SVG)?";
    }

    private void ResetGeneratedLogoSize() =>
        ResetLogoSize("Generated PTA Logo", _site?.LogoUrl, ref _editGeneratedLogoWidth, ref _editGeneratedLogoHeight);

    private void ResetPtaVariantLogoSize() =>
        ResetLogoSize("PTA Logo Variant", _editPtaLogoVariantUrl, ref _editPtaVariantLogoWidth, ref _editPtaVariantLogoHeight);

    private void ResetDistrictLogoSize() =>
        ResetLogoSize("District Logo", _editDistrictLogoUrl, ref _editDistrictLogoWidth, ref _editDistrictLogoHeight);

    private void ResetPartnerLogoSize() =>
        ResetLogoSize("Partner Logo", _editPartnerLogoUrl, ref _editPartnerLogoWidth, ref _editPartnerLogoHeight);

    // A freshly uploaded image is a different file — its old size (if any)
    // no longer describes it, so this always overwrites Width/Height with
    // the new file's own pixels rather than only filling blanks like
    // EnterEditBranding's initial seeding does.
    private void OnPtaVariantLogoUploaded(string url)
    {
        _editPtaLogoVariantUrl = url;
        ApplyNaturalSize(url, ref _editPtaVariantLogoWidth, ref _editPtaVariantLogoHeight);
    }

    private void OnDistrictLogoUploaded(string url)
    {
        _editDistrictLogoUrl = url;
        ApplyNaturalSize(url, ref _editDistrictLogoWidth, ref _editDistrictLogoHeight);
    }

    private void OnPartnerLogoUploaded(string url)
    {
        _editPartnerLogoUrl = url;
        ApplyNaturalSize(url, ref _editPartnerLogoWidth, ref _editPartnerLogoHeight);
    }

    private async Task SaveBrandingAsync()
    {
        if (_site is null)
            return;

        _savingBranding = true;
        _brandingError = null;

        var branding = new BrandingUpdate
        {
            BannerUrl = _editBannerUrl,
            HeaderText = _editHeaderText,
            PrimaryColor = _editPrimaryColor,
            AccentColor = _editAccentColor,
            TopBarColor = _editTopBarColor,
            FooterColor1 = _editFooterColor1,
            FooterColor2 = _editFooterColor2,
            FooterColor3 = _editFooterColor3,
            FooterColor4 = _editFooterColor4,
            MenuBackgroundImageUrl = _editMenuBackgroundImageUrl,
            PageBackgroundImageUrl = _editPageBackgroundImageUrl,
            PTALogoVariantUrl = _editPtaLogoVariantUrl,
            DistrictLogoUrl = _editDistrictLogoUrl,
            SchoolCrestUrl = _editSchoolCrestUrl,
            PartnerLogoUrl = _editPartnerLogoUrl,
            MastheadLogoDefaultWidth = _editMastheadLogoDefaultWidth,
            MastheadLogoDefaultHeight = _editMastheadLogoDefaultHeight,
            GeneratedLogoWidth = _editGeneratedLogoWidth,
            GeneratedLogoHeight = _editGeneratedLogoHeight,
            GeneratedLogoPreserveAspectRatio = _editGeneratedLogoPreserveAspectRatio,
            PtaVariantLogoWidth = _editPtaVariantLogoWidth,
            PtaVariantLogoHeight = _editPtaVariantLogoHeight,
            PtaVariantLogoPreserveAspectRatio = _editPtaVariantLogoPreserveAspectRatio,
            DistrictLogoWidth = _editDistrictLogoWidth,
            DistrictLogoHeight = _editDistrictLogoHeight,
            DistrictLogoPreserveAspectRatio = _editDistrictLogoPreserveAspectRatio,
            PartnerLogoWidth = _editPartnerLogoWidth,
            PartnerLogoHeight = _editPartnerLogoHeight,
            PartnerLogoPreserveAspectRatio = _editPartnerLogoPreserveAspectRatio,
        };

        var result = await SiteAdminService.UpdateBrandingAsync(_site.Id, branding);

        _savingBranding = false;

        if (!result.Success)
        {
            _brandingError = result.Error;
            return;
        }

        _site = result.Site;
        _editingBranding = false;
    }

    // Live preview source: the in-progress edit fields while the Branding
    // card is open, otherwise whatever's actually saved. ParentSite/SiteType/
    // LogoUrl always come from the real site — only the fields this card
    // edits are swapped, so Resolved*Color()'s parent-Division fallback still
    // works correctly for a Local Unit with nothing of its own set.
    // The 3 footer text helpers below mirror DivisionLayout.razor's
    // footer-nav/footer-links/footer-legal and UnitLayout.razor's
    // unit-footer-nav/unit-footer-links/unit-footer-legal exactly (including
    // the two static National/State PTA links Division has that Local Unit
    // doesn't, and the trademark line Division has that Local Unit doesn't)
    // — read from _site directly, not previewSite, since Social Links is a
    // separate edit card with no live in-progress state feeding this preview.
    private string FooterNavText() => _site!.SiteType == SiteType.Division
        ? "Home | Our Local Units | Programs | Get Involved | Events | Sponsors | News/Announcements | Awards | Admin"
        : "Home | Announcements | Admin";

    private string FooterQuickLinksText()
    {
        var links = new List<string>();
        if (!string.IsNullOrWhiteSpace(_site!.GiveBacksURL)) links.Add("GiveBacks");
        if (!string.IsNullOrWhiteSpace(_site.FaceBookURL)) links.Add("Facebook");
        if (!string.IsNullOrWhiteSpace(_site.TwitterURL)) links.Add("Twitter");
        if (!string.IsNullOrWhiteSpace(_site.InstagramURL)) links.Add("Instagram");
        if (!string.IsNullOrWhiteSpace(_site.SignUpGeniusURL)) links.Add("Sign Up Genius");

        if (_site.SiteType == SiteType.Division)
        {
            links.Add("State PTA");
            links.Add("National PTA");
        }

        return links.Count == 0 ? "Quick Links:" : $"Quick Links: {string.Join(" | ", links)}";
    }

    private string FooterLegalText()
    {
        var text = $"© {_site!.SiteName}";
        if (!string.IsNullOrWhiteSpace(_site.PtaId) && _site.PtaId != "00000000")
            text += $". PTA ID# {_site.PtaId}";
        if (_site.SiteType == SiteType.Division)
            text += " - PTA trademarks are acknowledged and respected.";
        return text;
    }

    private Site BuildPreviewSite()
    {
        if (!_editingBranding || _site is null)
            return _site ?? new Site();

        return new Site
        {
            SiteType = _site.SiteType,
            ParentSite = _site.ParentSite,
            SiteName = _site.SiteName,
            LogoUrl = _site.LogoUrl,
            PTALogoVariantUrl = _editPtaLogoVariantUrl,
            DistrictLogoUrl = _editDistrictLogoUrl,
            SchoolCrestUrl = _editSchoolCrestUrl,
            PartnerLogoUrl = _editPartnerLogoUrl,
            BannerUrl = _editBannerUrl,
            HeaderText = _editHeaderText,
            PrimaryColor = _editPrimaryColor,
            AccentColor = _editAccentColor,
            TopBarColor = _editTopBarColor,
            FooterColor1 = _editFooterColor1,
            FooterColor2 = _editFooterColor2,
            FooterColor3 = _editFooterColor3,
            FooterColor4 = _editFooterColor4,
            MastheadLogoDefaultWidth = _editMastheadLogoDefaultWidth,
            MastheadLogoDefaultHeight = _editMastheadLogoDefaultHeight,
            GeneratedLogoWidth = _editGeneratedLogoWidth,
            GeneratedLogoHeight = _editGeneratedLogoHeight,
            GeneratedLogoPreserveAspectRatio = _editGeneratedLogoPreserveAspectRatio,
            PtaVariantLogoWidth = _editPtaVariantLogoWidth,
            PtaVariantLogoHeight = _editPtaVariantLogoHeight,
            PtaVariantLogoPreserveAspectRatio = _editPtaVariantLogoPreserveAspectRatio,
            DistrictLogoWidth = _editDistrictLogoWidth,
            DistrictLogoHeight = _editDistrictLogoHeight,
            DistrictLogoPreserveAspectRatio = _editDistrictLogoPreserveAspectRatio,
            PartnerLogoWidth = _editPartnerLogoWidth,
            PartnerLogoHeight = _editPartnerLogoHeight,
