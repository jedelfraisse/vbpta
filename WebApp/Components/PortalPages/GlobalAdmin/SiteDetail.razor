                        so they're saved here but won't appear below or on the real site.
                    </p>
                    @{ var previewSite = BuildPreviewSite(); }
                    <div class="site-preview-shell" style="@SiteLayoutBase.ThemeStyle(previewSite)">
                        <div class="site-preview-topbar"></div>
