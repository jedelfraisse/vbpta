@* Loaded by SharedPages/Home.razor when SiteContext.CurrentSite.SiteType == SiteType.Portal *@
@using SiteEngine.Entities
@using WebApp.Services
@inject DashboardService DashboardService

<div class="home-container container py-4">

    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section class="hero text-center mb-5">
        <h1 class="display-5 fw-bold">Welcome to the Central Portal</h1>
        <p class="lead col-lg-8 mx-auto">
            A shared home for PTA groups, school organizations, booster clubs, councils,
            and community groups to build their online presence, connect with the people
            they serve, and share tools with one another.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a class="btn btn-primary btn-lg" href="/unit-sites">Browse Unit Sites</a>
            <a class="btn btn-outline-primary btn-lg" href="/portal-tools">Explore Tools</a>

            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-success btn-lg" href="/dashboard">Go to Dashboard</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary btn-lg" href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- WHAT THIS PLATFORM IS                                         -->
    <!-- ============================================================ -->
    <section class="mb-5">
        <h2>One Platform, Many Communities</h2>
        <p>
            Central Portal is a community management platform that helps organizations govern, organize, communicate, and engage with their members while providing each community its own branded space and specialized tools.
        </p>
    </section>

    <!-- ============================================================ -->
    <!-- WHO WE SERVE                                                  -->
    <!-- ============================================================ -->
    @if (_organizationTypes.Count > 0)
    {
        <section class="mb-5">
            <h2>Who We Serve</h2>
            <div class="row g-3 mt-1">
                @foreach (var org in _organizationTypes)
                {
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h3 class="h6 card-title">
                                    @if (!string.IsNullOrWhiteSpace(org.IconClass))
                                    {
                                        <i class="@org.IconClass me-2" aria-hidden="true"></i>
                                    }
                                    @org.Name
                                </h3>
                                <p class="card-text text-muted small">@Excerpt(org.Description)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <p class="mt-3">
                <a href="/organizations">Learn more about who we serve &rarr;</a>
            </p>
        </section>
    }

    <!-- ============================================================ -->
    <!-- HOW IT'S ORGANIZED                                            -->
    <!-- ============================================================ -->
    <section class="mb-5">
        <h2>How It's Organized</h2>
        <p>
            The portal follows a simple two-level structure. A <strong>Division</strong> is a
            larger organizing body — often a city, regional, or district-level council — and
            each Division can be home to many <strong>Local Units</strong>, the individual
            groups doing the day-to-day work in their own community.
        </p>
        <p>
            Local Units can also stand on their own without belonging to a Division at all.
            Either way, every site in the portal fits somewhere in this same familiar shape:
        </p>
        <p class="fw-semibold text-center">
            Central Portal &rarr; Divisions &rarr; Local Units
        </p>
    </section>

    <!-- ============================================================ -->
    <!-- WHAT VISITORS / REGISTERED USERS CAN DO                       -->
    <!-- ============================================================ -->
    <section class="mb-5">
        <h2>What You Can Do Here</h2>

        <div class="row g-4 mt-1">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">Just Visiting</h3>
                        <p class="card-text text-muted">
                            You don't need an account to start exploring:
                        </p>
                        <ul>
                            <li>Browse Divisions and Local Units</li>
                            <li>Explore each site's public information</li>
                            <li>Learn about the tools available on the portal</li>
                            <li>Understand how membership works before you join</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">Once You're Signed In</h3>
                        <p class="card-text text-muted">
                            Creating an account opens up a lot more:
                        </p>
                        <ul>
                            <li>Apply for a Division or Local Unit site</li>
                            <li>Access member-only content for your groups</li>
                            <li>Use tools built for members and admins</li>
                            <li>Manage your memberships in one place</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- DASHBOARD (AUTHENTICATED ONLY)                                -->
    <!-- ============================================================ -->
    <AuthorizeView>
        <Authorized>
            <section class="mb-5">
                <h2>Your Dashboard</h2>
                <p>
                    Your Dashboard is your personal starting point on the portal. It brings
                    together your memberships, any applications you've submitted, and the
                    unit and Division sites you've recently visited — so you always know
                    where things stand across every group you're part of.
                </p>
                <a class="btn btn-success" href="/dashboard">Go to Dashboard</a>
            </section>
        </Authorized>
    </AuthorizeView>

    <!-- ============================================================ -->
    <!-- CLOSING CTA                                                   -->
    <!-- ============================================================ -->
    <section class="text-center">
        <h2>Ready to Explore?</h2>
        <p class="col-lg-6 mx-auto">
            Start by browsing the Divisions and Local Units already on the portal, or take
            a look at the tools available to help your own group get organized.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" href="/unit-sites">Browse Unit Sites</a>
            <a class="btn btn-outline-primary" href="/portal-tools">Explore Tools</a>

            <AuthorizeView>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary" href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>

</div>

@code {
    private List<OrganizationType> _organizationTypes = new();

    protected override async Task OnInitializedAsync()
    {
        _organizationTypes = await DashboardService.GetOrganizationTypesAsync();
    }

    // Home page teaser card gets a short excerpt, not the full description —
    // the full text is what /organizations is for.
    private static string Excerpt(string description, int maxLength = 110)
    {
        if (description.Length <= maxLength)
            return description;

        var trimmed = description[..maxLength];
        var lastSpace = trimmed.LastIndexOf(' ');
        if (lastSpace > 0)
            trimmed = trimmed[..lastSpace];

        return trimmed + "…";
    }
}
