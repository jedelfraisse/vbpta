@page "/portal-tools"

<div class="container">
    <h1>Tools</h1>
    <p class="lead">Tools available in Central Portal</p>

    <div class="row g-3">
        @foreach (var tool in _placeholderTools)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title d-flex align-items-center gap-2">
                            <i class="@tool.IconClass" aria-hidden="true"></i>
                            @tool.Name
                            <span class="badge text-bg-light border">Coming soon</span>
                        </h5>
                        <p class="card-text text-muted">@tool.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<PlaceholderTool> _placeholderTools = new()
    {
        new("GiveBacks Membership Import Tool", "Import member emails from a GiveBacks CSV export.", "fa-solid fa-file-import"),
        new("Bingo Caller", "Call numbers for in-person bingo events.", "fa-solid fa-dice"),
        new("Newsletter Builder", "Draft and send unit newsletters.", "fa-solid fa-newspaper"),
        new("Event Calendar", "Browse upcoming portal-wide events.", "fa-solid fa-calendar-days"),
    };

    private record PlaceholderTool(string Name, string Description, string IconClass);
}
