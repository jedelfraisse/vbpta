@page "/unit-sites"

<div class="container">
    <h1>Unit Sites</h1>
    <p class="lead">Browse PTA Divisions and Local Units</p>

    <div class="row g-2 mb-4">
        <div class="col-sm-8">
            <input type="search" class="form-control" placeholder="Search by name..." @bind="_searchText" />
        </div>
        <div class="col-sm-4">
            <select class="form-select" @bind="_typeFilter">
                <option value="">All Types</option>
                <option value="Division">Division</option>
                <option value="LocalUnit">Local Unit</option>
            </select>
        </div>
    </div>

    <div class="list-group">
        @foreach (var site in _placeholderSites)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@site.Name</div>
                    <span class="badge text-bg-secondary">@site.Type</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <AuthorizeView>
                        <Authorized>
                            <span class="badge text-bg-info">@site.Status</span>
                        </Authorized>
                    </AuthorizeView>

                    @* Clicking conceptually opens the site's public info only - not wired up yet *@
                    <a class="btn btn-sm btn-outline-primary" href="#">View Public Info</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _searchText = string.Empty;
    private string _typeFilter = string.Empty;

    private readonly List<PlaceholderSite> _placeholderSites = new()
    {
        new("Virginia Beach Division", "Division", "Guest"),
        new("Chesapeake Division", "Division", "Member"),
        new("Luxford Elementary PTA", "Local Unit", "Admin"),
        new("Tallwood Elementary PTA", "Local Unit", "Guest"),
    };

    private record PlaceholderSite(string Name, string Type, string Status);
}
