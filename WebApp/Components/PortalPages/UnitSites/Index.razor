@page "/unit-sites"
@using SiteEngine.Enums
@using WebApp.Services
@inject OrganizationService OrganizationService

@* URL deliberately unchanged (still /unit-sites) — see
   OrganizationPublicExperience-Phase1.md's "Resolved Decisions": no
   bookmark/link breaks, only the query behind this page moves from Site to
   Organization. A future phase may rename the route itself (e.g. to
   /communities) once this has proven out. *@

<div class="container">
    <h1>Community Directory</h1>
    <p class="lead">Browse communities in the directory</p>

    <div class="row g-2 mb-3 align-items-center">
        <div class="col-sm-6">
            <input type="search" class="form-control" placeholder="Search by name..."
                   value="@_searchText" @oninput="OnSearchChanged" />
        </div>
        <div class="col-sm-4">
            <select class="form-select" value="@_organizationTypeId" @onchange="OnTypeChanged">
                <option value="">All Organization Types</option>
                @foreach (var type in _types)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-2 text-muted small text-sm-end">
            @_organizations.Count communit@(_organizations.Count == 1 ? "y" : "ies")
        </div>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading&hellip;</p>
    }
    else if (_organizations.Count == 0)
    {
        <p class="text-muted">No communities match your search.</p>
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var org in _organizations)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="@($"/communities/{org.IdentifierValue ?? org.Id.ToString()}")">
                    <div>
                        <div class="fw-semibold">@org.Name</div>
                        <span class="text-muted small">
                            @org.OrganizationTypeName &middot; @org.OrganizationLevelName
                            @if (org.ParentOrganizationName is not null)
                            {
                                <text> &middot; part of @org.ParentOrganizationName</text>
                            }
                        </span>
                    </div>
                    <span class="badge text-bg-light border">@PresenceLabel(org.PresenceType)</span>
                </a>
            }
        </div>
    }
</div>

@code {
    // Flat list, not paginated — Phase 1 scale. Grouping/pagination the way
    // the old Division/Local Unit listing did is a reasonable later
    // enhancement once there's enough real directory data to need it (see
    // OrganizationPublicExperience.md's "Future Enhancements").
    private List<OrganizationTypeSummary> _types = new();
    private List<OrganizationSummary> _organizations = new();
    private string _searchText = string.Empty;
    private int? _organizationTypeId;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _types = await OrganizationService.GetOrganizationTypeSummariesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _organizations = await OrganizationService.GetDirectoryOrganizationsAsync(_searchText, _organizationTypeId);
        _loading = false;
    }

    private Task OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        return LoadAsync();
    }

    private Task OnTypeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _organizationTypeId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
        return LoadAsync();
    }

    private static string PresenceLabel(PresenceType type) => type switch
    {
        PresenceType.Hosted => "Hosted",
        PresenceType.External => "External Website",
        _ => "Directory Listing"
    };
}
