@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Services
@inject FileUploadService FileUploadService

<div class="mb-3">
    <label class="form-label fw-semibold">@Label</label>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        @if (!string.IsNullOrWhiteSpace(CurrentUrl))
        {
            <img src="@CurrentUrl" alt="@Label" class="img-thumbnail" style="max-height:60px;max-width:160px;object-fit:contain;" />
        }
        <InputFile OnChange="HandleFileSelectedAsync" accept="image/*" disabled="@_uploading" class="form-control" style="max-width:320px;" />
        @if (_uploading)
        {
            <span class="text-muted small">Uploading…</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="text-danger small mt-1">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="text-success small mt-1">@_success</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? CurrentUrl { get; set; }
    [Parameter, EditorRequired] public string UploadFolder { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> OnUploaded { get; set; }

    private bool _uploading;
    private string? _error;
    private string? _success;

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _success = null;
        _uploading = true;

        try
        {
            var url = await FileUploadService.SaveImageAsync(e.File, UploadFolder);
            CurrentUrl = url;
            await OnUploaded.InvokeAsync(url);
            _success = "Uploaded.";
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }
}
