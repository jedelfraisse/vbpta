@page "/admin"
@inject NavigationManager NavigationManager
@inject ISiteContext SiteContext
@inject IAdminDashboardService AdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin Portal</PageTitle>

<h1>Admin Dashboard</h1>

@if (!_initialized)
{
	<p>Loading admin context...</p>
}
else if (_showGlobalDashboard)
{
	<div class="admin-actions">
		<a class="btn btn-primary" href="/globaladmin/sites">Manage Sites</a>
		<a class="btn btn-secondary" href="/globaladmin/users">Manage Users</a>
		<a class="btn btn-secondary" href="/globaladmin/settings">Platform Settings</a>
	</div>

	@if (_overview is not null)
	{
		<div class="dashboard-grid">
			<div class="dashboard-card">
				<h3>Sites</h3>
				<p>@_overview.TotalSites</p>
			</div>
			<div class="dashboard-card">
				<h3>Total Users</h3>
				<p>@_overview.TotalUsers</p>
			</div>
			<div class="dashboard-card">
				<h3>Assigned Users</h3>
				<p>@_overview.AssignedUsers</p>
			</div>
			<div class="dashboard-card">
				<h3>Global Admins</h3>
				<p>@_overview.GlobalAdmins</p>
			</div>
		</div>
	}

	<p>Use the management pages above for site and user administration.</p>
}
else
{
	<h2>@_localSiteName Admin</h2>
	<p>Managing site: <strong>@_localSiteHostname</strong></p>
	<p>
		Use this site's admin page for local administration tasks.
		If you need cross-site management, switch to the global admin host.
	</p>
}

@code {
	private bool _initialized;
	private bool _showGlobalDashboard;
	private string? _userId;
	private AdminDashboardOverview? _overview;
	private string? _localSiteName;
	private string? _localSiteHostname;

	protected override async Task OnInitializedAsync()
	{
		var host = new Uri(NavigationManager.Uri).Host;
		await SiteContext.InitializeAsync(host);
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
		_userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
		if (!isAuthenticated)
		{
			NavigationManager.NavigateTo("/", forceLoad: true);
			return;
		}

		var hasSiteAdminAccess = await SiteContext.UserHasSiteAdminAccessAsync(_userId);
		if (!hasSiteAdminAccess)
		{
			NavigationManager.NavigateTo("/", forceLoad: true);
			return;
		}

		var hasGlobalAdminAccess = await SiteContext.UserHasGlobalAdminRoleAsync(_userId);
		_showGlobalDashboard = SiteContext.IsAdminContext && hasGlobalAdminAccess;
		if (_showGlobalDashboard)
		{
			_overview = await AdminDashboardService.GetOverviewAsync(_userId);
		}
		else
		{
			_localSiteName = SiteContext.CurrentSite?.SiteName ?? "Site";
			_localSiteHostname = SiteContext.CurrentSite?.Hostname;
		}

		_initialized = true;
	}
}

<style>
	.admin-actions {
		margin-bottom: 1rem;
		display: flex;
		gap: 0.75rem;
	}

	.dashboard-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.dashboard-card {
		border: 1px solid #ddd;
		border-radius: 8px;
		padding: 1rem;
		background: #fff;
	}

	.dashboard-card h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1rem;
	}

	.dashboard-card p {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
	}
</style>
