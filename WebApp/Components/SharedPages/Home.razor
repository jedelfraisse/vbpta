@page "/"
@using WebApp.Services
@using SiteEngine.Enums
@inject SiteContext SiteContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@using WebApp.Components.DivisionPages
@using WebApp.Components.UnitPages
@using WebApp.Components.PortalPages

<PageTitle>@SiteContext.CurrentSite?.SiteName</PageTitle>

@if (SiteContext.SiteNotFound)
{
    <h2>Sorry, I didn’t find that local unit.</h2>
}
else
{
    @switch (SiteContext.CurrentSite!.SiteType)
    {
        case SiteType.Portal:
            <PortalHome />
            break;

        case SiteType.Division:
            <DivisionHome DivisionId="@SiteContext.CurrentSite.Id" />
            break;

        case SiteType.LocalUnit:
            <UnitHome UnitId="@SiteContext.CurrentSite.Id" />
            break;

        default:
            <h5>No Home Page Available</h5>
            break;
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        var host = new Uri(NavigationManager.Uri).Host;
        await SiteContext.InitializeAsync(host);
    }
}
