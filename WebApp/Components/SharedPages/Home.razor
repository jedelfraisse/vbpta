@page "/"
@using WebApp.Services
@using SiteEngine.Enums
@inject SiteContext SiteContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@using WebApp.Components.DivisionPages
@using WebApp.Components.UnitPages
@using WebApp.Components.PortalPages

<PageTitle>@SiteContext.CurrentSite?.SiteName</PageTitle>

@if (SiteContext.CurrentSite is null)
{
    @* Still resolving the current site from the request host — CurrentSite
       is null both before InitializeAsync has run and, briefly, during
       Blazor's initial prerender pass while its DB call is in flight. *@
}
else if (SiteContext.SiteNotFound)
{
    <h2>Sorry, we couldn't find "@SiteContext.RequestedHost".</h2>
    <p>There's no Division or Local Unit site at that address. Double-check the link, or use the navigation above to browse Divisions and Local Units.</p>
}
else
{
    @switch (SiteContext.CurrentSite.SiteType)
    {
        case SiteType.Portal:
            <PortalHome />
            break;

        case SiteType.Division:
            <DivisionHome DivisionId="@SiteContext.CurrentSite.Id" />
            break;

        case SiteType.LocalUnit:
            <UnitHome UnitId="@SiteContext.CurrentSite.Id" />
            break;

        default:
            <h5>No Home Page Available</h5>
            break;
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        var host = new Uri(NavigationManager.Uri).Host;
        await SiteContext.InitializeAsync(host);
    }
}
