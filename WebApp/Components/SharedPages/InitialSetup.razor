@inject NavigationManager NavigationManager
@inject IPlatformConfigurationService PlatformConfigurationService
@using System.Net.Mail
@using System.Net.Sockets

<PageTitle>Initial Setup</PageTitle>

@if (!_initialized)
{
	<div class="setup-page">
		<p class="setup-muted">Loading setup...</p>
	</div>
}
else if (!_setupRequired)
{
	<div class="setup-page">
		<p class="setup-muted">Initial setup is already complete.</p>
	</div>
}
else
{
	<div class="setup-page">
		<header class="setup-header">
			<h1>Welcome! Let’s set up your PTA platform</h1>
			<p class="setup-muted">This one-time setup creates your city-wide site, configures admin access, and enables email-based sign-in.</p>
		</header>

		<EditForm Model="_request" OnValidSubmit="HandleFormSubmitAsync">
			<DataAnnotationsValidator />
			<ValidationSummary class="setup-validation" />

			<section class="setup-group">
				<h3>1. Platform & Admin</h3>
				<p class="setup-help">The admin email becomes your first platform administrator. Domains control where your city site and unit sites are hosted.</p>
				<div class="group-grid">
					<div>
						<label for="adminEmail">Admin Email</label>
						<InputText id="adminEmail" @bind-Value="_request.AdminEmail" />
					</div>
					<div>
						<label for="rootDomain">Root Domain</label>
						<InputText id="rootDomain" @bind-Value="_request.RootDomain" />
						<div class="field-help">Example: <code>vbpta.delfraisse.com</code></div>
					</div>
					<div class="full-width">
						<label for="platformDomain">Platform Domain (for unit sites)</label>
						<InputText id="platformDomain" @bind-Value="_request.PlatformDomain" />
						<div class="field-help">Example: <code>luxfordes.vbpta.delfraisse.com</code> resolves from this domain.</div>
					</div>
				</div>
			</section>

			<section class="setup-group">
				<h3>2. City-Wide Site Branding</h3>
				<p class="setup-help">These values define your city-wide homepage and default theme for launch.</p>
				<div class="group-grid">
					<div>
						<label for="cityWideSiteName">City-Wide PTA Name</label>
						<InputText id="cityWideSiteName" @bind-Value="_request.CityWideSiteName" />
					</div>
					<div>
						<label for="cityWidePtaId">City-Wide PTA ID (8 digits)</label>
						<InputText id="cityWidePtaId" @bind-Value="_request.CityWidePtaId" />
					</div>
					<div>
						<label for="cityWidePrimaryColor">Primary Color</label>
						<InputText id="cityWidePrimaryColor" @bind-Value="_request.CityWidePrimaryColor" />
					</div>
					<div>
						<label for="cityWideAccentColor">Accent Color</label>
						<InputText id="cityWideAccentColor" @bind-Value="_request.CityWideAccentColor" />
					</div>
					<div class="full-width">
						<label for="cityWideWelcomeText">Welcome Text</label>
						<InputTextArea id="cityWideWelcomeText" @bind-Value="_request.CityWideWelcomeText" />
					</div>
					<div class="full-width image-preview-grid">
						<div class="preview-card">
							<div class="preview-title">Default Logo</div>
							<img src="/images/logo.png" alt="Default PTA logo preview" class="preview-logo" />
							<div class="field-help"><code>/images/logo.png</code></div>
						</div>
						<div class="preview-card">
							<div class="preview-title">Default Banner</div>
							<img src="/images/banner.png" alt="Default PTA banner preview" class="preview-banner" />
							<div class="field-help"><code>/images/banner.png</code></div>
						</div>
					</div>
				</div>
			</section>

			<section class="setup-group">
				<h3>3. Email Sign-In (SMTP) <span class="@GetStatusCssClass(GetSmtpSectionStatus())">@GetStatusText(GetSmtpSectionStatus())</span></h3>
				<p class="setup-help">Admins and users receive email codes for login. We’ll test connectivity and delivery before saving setup.</p>
				<div class="group-grid">
					<div>
						<label for="smtpHost">SMTP Host</label>
						<InputText id="smtpHost" @bind-Value="_request.SmtpHost" />
					</div>
					<div>
						<label for="smtpPort">SMTP Port</label>
						<InputNumber id="smtpPort" @bind-Value="_request.SmtpPort" />
					</div>
					<div>
						<label for="smtpFromAddress">Default From Email</label>
						<InputText id="smtpFromAddress" @bind-Value="_request.SmtpFromAddress" />
						<div class="field-help">Recommended: <code>@GetRecommendedFromAddress()</code></div>
					</div>
					<div>
						<label for="smtpUsername">SMTP Username</label>
						<InputText id="smtpUsername" @bind-Value="_request.SmtpUsername" />
					</div>
					<div>
						<label for="smtpPassword">SMTP Password</label>
						<InputText id="smtpPassword" type="password" @bind-Value="_request.SmtpPassword" />
					</div>
					<div class="checkbox-field">
						<label for="useSsl">Use SSL</label>
						<InputCheckbox id="useSsl" @bind-Value="_request.UseSsl" />
					</div>
				</div>

				@if (!string.IsNullOrWhiteSpace(_verificationCode))
				{
					<div class="verification-box">
						<h4>Email Verification</h4>
						<p>We sent a verification code to <strong>@_request.AdminEmail</strong>. Enter it below to confirm delivery.</p>
						<div class="verification-input-row">
							<div>
								<label for="verificationCode">Enter Verification Code</label>
								<InputText id="verificationCode" @bind-Value="_verificationInput" placeholder="Enter 6-8 digit code" />
							</div>
							<button type="button" @onclick="VerifyCode" disabled="@_verificationConfirmed">Verify</button>
						</div>
						@if (!string.IsNullOrWhiteSpace(_verificationError))
						{
							<p class="error-text">@_verificationError</p>
						}
						@if (_verificationConfirmed)
						{
							<p class="success-text">Email verification confirmed.</p>
						}
					</div>
				}
			</section>

			<section class="setup-group">
				<h3>4. Finalize Setup <span class="@GetStatusCssClass(_steps[2].Status)">@GetStatusText(_steps[2].Status)</span></h3>
				<p class="setup-help">After completion, you’ll be redirected to the admin host for ongoing platform management.</p>
				@if (string.IsNullOrWhiteSpace(_verificationCode))
				{
					<button type="submit" disabled="@_isRunning">Send Test Email</button>
				}
				else if (!_verificationConfirmed)
				{
					<p class="info-text">Please verify the email code before continuing.</p>
				}
				else
				{
					<button type="submit" disabled="@_isRunning" @onclick="FinalizeSetupAsync">Complete Setup</button>
				}
				@if (!string.IsNullOrWhiteSpace(_statusMessage))
				{
					<p class="error-text">@_statusMessage</p>
				}
			</section>
		</EditForm>
	</div>
}

@code {
	private bool _initialized;
	private bool _setupRequired;
	private bool _isRunning;
	private string _statusMessage = string.Empty;
	private string _verificationCode = string.Empty;
	private string _verificationInput = string.Empty;
	private string _verificationError = string.Empty;
	private bool _verificationConfirmed;
	private InitialSetupRequest _request = new();
	private readonly List<SetupStep> _steps =
	[
		new("Testing SMTP connectivity"),
		new("Sending SMTP test email"),
		new("Verifying email delivery"),
		new("Saving setup data")
	];

	protected override async Task OnInitializedAsync()
	{
		_setupRequired = await PlatformConfigurationService.IsInitialSetupRequiredAsync();
		if (!_setupRequired)
		{
			_initialized = true;
			return;
		}

		var host = new Uri(NavigationManager.Uri).Host;
		var normalizedHost = host.Replace("admin.", string.Empty, StringComparison.OrdinalIgnoreCase);
		_request = new InitialSetupRequest
		{
			AdminEmail = string.Empty,
			CityWideSiteName = "Virginia Beach Council of PTAs",
			CityWidePtaId = "10000000",
			CityWidePrimaryColor = "#003366",
			CityWideAccentColor = "#FFCC00",
			CityWideWelcomeText = "Welcome to our community! We are dedicated to supporting students, families, and educators.",
			RootDomain = normalizedHost,
			PlatformDomain = normalizedHost,
			SmtpHost = string.Empty,
			SmtpPort = 587,
			SmtpFromAddress = $"help@{normalizedHost}",
			SmtpUsername = string.Empty,
			SmtpPassword = string.Empty,
			UseSsl = true
		};

		_initialized = true;
	}

	private async Task CompleteSetupAsync()
	{
		ResetSteps();
		_statusMessage = string.Empty;
		_verificationError = string.Empty;
		_isRunning = true;
		try
		{
			_steps[0].Status = SetupStepStatus.InProgress;
			StateHasChanged();
			await PlatformConfigurationService.TestSmtpConnectionAsync(_request);
			_steps[0].Status = SetupStepStatus.Succeeded;
			_steps[0].Message = "SMTP host/port is reachable.";

			_steps[1].Status = SetupStepStatus.InProgress;
			StateHasChanged();
			_verificationCode = await PlatformConfigurationService.SendSetupTestEmailAsync(_request);
			_verificationInput = string.Empty;
			_verificationConfirmed = false;
			_steps[1].Status = SetupStepStatus.Succeeded;
			_steps[1].Message = $"Test email sent to {_request.AdminEmail}.";
			_isRunning = false;
			StateHasChanged();
		}
		catch (Exception ex) when (ex is InvalidOperationException || ex is SocketException || ex is SmtpException)
		{
			var message = ex.Message;
			var currentStep = _steps.FirstOrDefault(x => x.Status == SetupStepStatus.InProgress);
			if (currentStep is not null)
			{
				currentStep.Status = SetupStepStatus.Failed;
				currentStep.Message = message;
			}

			_statusMessage = message;
			_isRunning = false;
		}
	}

	private async Task FinalizeSetupAsync()
	{
		if (!_verificationConfirmed)
		{
			_verificationError = "Please verify the email code first.";
			return;
		}

		_statusMessage = string.Empty;
		_verificationError = string.Empty;
		_isRunning = true;
		try
		{
			_steps[2].Status = SetupStepStatus.InProgress;
			StateHasChanged();
			
			using var saveCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
			await PlatformConfigurationService.CompleteInitialSetupAsync(_request, saveCts.Token);
			_steps[2].Status = SetupStepStatus.Succeeded;
			_steps[2].Message = "Configuration saved.";

			var currentUri = new Uri(NavigationManager.Uri);
			var builder = new UriBuilder(currentUri.Scheme, $"admin.{_request.RootDomain}", currentUri.IsDefaultPort ? -1 : currentUri.Port)
			{
				Path = "/"
			};
			NavigationManager.NavigateTo(builder.Uri.ToString(), forceLoad: true);
		}
		catch (Exception ex) when (ex is InvalidOperationException || ex is OperationCanceledException)
		{
			var message = ex is OperationCanceledException
				? "Saving setup data timed out. Please retry; if it persists, check database connectivity."
				: ex.Message;
			_steps[2].Status = SetupStepStatus.Failed;
			_steps[2].Message = message;
			_statusMessage = message;
		}
		finally
		{
			_isRunning = false;
		}
	}

	private async Task WaitForVerificationAsync()
	{
		// Simple polling approach - wait up to 5 minutes for user to enter code
		var deadline = DateTimeOffset.UtcNow.AddMinutes(5);
		while (DateTimeOffset.UtcNow < deadline)
		{
			if (_verificationConfirmed)
			{
				return;
			}

			await Task.Delay(500);
		}

		throw new InvalidOperationException("Email verification timeout. Please resend the test email.");
	}

	private async Task HandleFormSubmitAsync()
	{
		// If verification code hasn't been sent yet, send it
		if (string.IsNullOrWhiteSpace(_verificationCode))
		{
			await CompleteSetupAsync();
		}
	}

	private void VerifyCode()
	{
		_verificationError = string.Empty;
		
		if (string.IsNullOrWhiteSpace(_verificationInput))
		{
			_verificationError = "Please enter the verification code.";
			return;
		}

		if (_verificationInput == _verificationCode)
		{
			_verificationConfirmed = true;
		}
		else
		{
			_verificationError = "Verification code does not match. Please try again.";
		}
	}

	private SetupStepStatus GetSmtpSectionStatus()
	{
		if (_steps[0].Status == SetupStepStatus.Failed || _steps[1].Status == SetupStepStatus.Failed || _steps[2].Status == SetupStepStatus.Failed)
		{
			return SetupStepStatus.Failed;
		}

		if (_steps[0].Status == SetupStepStatus.InProgress || _steps[1].Status == SetupStepStatus.InProgress || _steps[2].Status == SetupStepStatus.InProgress)
		{
			return SetupStepStatus.InProgress;
		}

		if (_steps[0].Status == SetupStepStatus.Succeeded && _steps[1].Status == SetupStepStatus.Succeeded && _steps[2].Status == SetupStepStatus.Succeeded)
		{
			return SetupStepStatus.Succeeded;
		}

		return SetupStepStatus.Pending;
	}

	private void ResetSteps()
	{
		foreach (var step in _steps)
		{
			step.Status = SetupStepStatus.Pending;
			step.Message = string.Empty;
		}
	}

	private static string GetStatusText(SetupStepStatus status) => status switch
	{
		SetupStepStatus.Pending => "Pending",
		SetupStepStatus.InProgress => "In progress...",
		SetupStepStatus.Succeeded => "Done",
		SetupStepStatus.Failed => "Failed",
		_ => string.Empty
	};

	private static string GetStatusCssClass(SetupStepStatus status) => $"status-{status.ToString().ToLowerInvariant()}";

	private string GetRecommendedFromAddress()
	{
		var normalizedRoot = (_request.RootDomain ?? string.Empty).Trim().ToLowerInvariant();
		return string.IsNullOrWhiteSpace(normalizedRoot) ? "help@example.org" : $"help@{normalizedRoot}";
	}

	private sealed class SetupStep(string label)
	{
		public string Label { get; } = label;
		public SetupStepStatus Status { get; set; } = SetupStepStatus.Pending;
		public string Message { get; set; } = string.Empty;
	}

	private enum SetupStepStatus
	{
		Pending,
		InProgress,
		Succeeded,
		Failed
	}
}

<style>
	.setup-page {
		max-width: 980px;
		margin: 0 auto;
		padding: 1rem 1rem 2rem;
	}

	.setup-header {
		margin-bottom: 1rem;
	}

	.setup-header h1 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
	}

	.setup-muted {
		color: #4b5563;
		margin: 0;
	}

	.setup-help {
		margin: 0 0 0.8rem;
		color: #4b5563;
	}

	.setup-validation {
		margin-bottom: 1rem;
	}

	.setup-group {
		border: 1px solid #d7deea;
		border-radius: 10px;
		padding: 1rem;
		margin-bottom: 1rem;
		background: #ffffff;
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
	}

	.setup-group h3 {
		margin: 0 0 0.5rem;
	}

	.group-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(240px, 1fr));
		gap: 0.85rem 1rem;
	}

	label {
		display: inline-block;
		margin-bottom: 0.3rem;
		font-weight: 600;
	}

	input[type="text"],
	input[type="number"],
	textarea {
		width: 100%;
	}

	.field-help {
		margin-top: 0.25rem;
		font-size: 0.9rem;
		color: #4b5563;
	}

	.checkbox-field {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		align-items: flex-start;
	}

	.full-width {
		grid-column: 1 / -1;
	}

	.image-preview-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 0.85rem;
	}

	.preview-card {
		border: 1px solid #d7deea;
		border-radius: 8px;
		padding: 0.8rem;
		background: #f8fafc;
	}

	.preview-title {
		font-weight: 600;
		margin-bottom: 0.45rem;
	}

	.preview-logo {
		max-width: 160px;
		max-height: 80px;
		width: auto;
		height: auto;
		display: block;
		margin-bottom: 0.35rem;
	}

	.preview-banner {
		width: 100%;
		max-height: 120px;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid #d7deea;
		margin-bottom: 0.35rem;
	}

	.status-pending {
		color: #666;
	}

	.status-inprogress {
		color: #0b5ed7;
	}

	.status-succeeded {
		color: #198754;
	}

	.status-failed {
		color: #dc3545;
	}

	.error-text {
		color: #dc3545;
	}

	.success-text {
		color: #198754;
		font-weight: bold;
	}

	.info-text {
		color: #0b5ed7;
		font-weight: bold;
	}

	.verification-box {
		background: #f0f7ff;
		border: 1px solid #0b5ed7;
		border-radius: 6px;
		padding: 1rem;
		margin-top: 1rem;
	}

	.verification-input-row {
		display: flex;
		gap: 0.75rem;
		align-items: flex-end;
		flex-wrap: wrap;
	}

	.verification-box button {
		padding: 0.5rem 1rem;
		background: #0b5ed7;
		color: white;
		border: none;
		border-radius: 4px;
		cursor: pointer;
		font-weight: bold;
	}

	.verification-box button:hover:not(:disabled) {
		background: #0a58ca;
	}

	.verification-box button:disabled {
		background: #6c757d;
		cursor: not-allowed;
		opacity: 0.65;
	}

	@@media (max-width: 800px) {
		.group-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
