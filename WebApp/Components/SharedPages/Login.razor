@page "/login"
@inject NavigationManager NavigationManager
@inject PasswordlessSignInService PasswordlessSignInService

<PageTitle>Sign in</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 420px;">

        <div class="text-center mb-4">
            <div class="gateway-logo"></div>

<style>
.gateway-logo {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: radial-gradient(circle,
    #ffffff 0%,
    #a3d5a3 40%,
    #4caf50 100%);
  box-shadow: 0 0 8px rgba(0,0,0,0.2);
}
</style>
            <h3 class="mt-3">Sign in</h3>
            <p class="text-muted">Use your email address to receive a one‑time code.</p>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input id="email" type="email" class="form-control" @bind="_email" placeholder="you@example.com" />
        </div>

        @if (!_codeSent)
        {
            <button class="btn btn-primary w-100" @onclick="SendCodeAsync">
                Send sign‑in code
            </button>
        }
        else
        {
            <div class="mb-3 mt-4">
                <label for="code" class="form-label">One‑time code</label>
                <input id="code" type="text" class="form-control" @bind="_code" placeholder="123456" />
            </div>

            <button class="btn btn-success w-100" @onclick="VerifyCodeAsync">
                Sign in
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-info mt-3">
                @_statusMessage
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string _email = string.Empty;
    private string _code = string.Empty;
    private bool _codeSent;
    private string _statusMessage = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Error))
            _statusMessage = Error;
    }

    private async Task SendCodeAsync()
    {
        try
        {
            await PasswordlessSignInService.RequestCodeAsync(_email);
            _codeSent = true;

            // SAFE, NON‑ENUMERATING MESSAGE
            _statusMessage = "If your email is in our system, a sign‑in code has been sent.";
        }
        catch (InvalidOperationException ex)
        {
            _statusMessage = ex.Message;
        }
        catch (UserBannedException)
        {
            NavigationManager.NavigateTo("/banned", forceLoad: true);
        }
        catch (Exception)
        {
            // Don't let a send failure (SMTP misconfiguration, transient
            // network error, etc.) go unhandled — an uncaught exception here
            // terminates the whole Blazor Server circuit, which looks to the
            // user like the button silently did nothing rather than showing
            // an error.
            _statusMessage = "We couldn't send a sign‑in code right now. Please try again in a few minutes.";
        }
    }

    private Task VerifyCodeAsync()
    {
        var encodedEmail = Uri.EscapeDataString(_email ?? string.Empty);
        var encodedCode = Uri.EscapeDataString(_code ?? string.Empty);
        var encodedReturnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");

        NavigationManager.NavigateTo(
            $"/auth/passwordless/complete?email={encodedEmail}&code={encodedCode}&returnUrl={encodedReturnUrl}",
            forceLoad: true);

        return Task.CompletedTask;
    }
}
