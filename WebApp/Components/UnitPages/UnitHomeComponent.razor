<section class="unit-home-card">
    <h2>@SiteName</h2>
    <p>Welcome to your local unit page.</p>
    <p>Announcements, events, and local details for this unit will appear here.</p>
</section>

@code {
    [Parameter]
    [EditorRequired]
    public string SiteName { get; set; } = string.Empty;
}
